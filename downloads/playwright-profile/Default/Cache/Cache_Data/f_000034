        document.addEventListener("DOMContentLoaded", (event) => {
            const url = new URL(window.location);
            const msg = url.searchParams.get('msg');
            if (msg) {
                let title = url.searchParams.get('title');
                if (!title) {
                    title = 'Pago procesado';
                }
                const type = url.searchParams.get('type');
                history.replaceState({}, 'BambuCR', '/app/');
                swal({
                    title,
                    text: msg,
                    type: type,
                    confirmButtonText: 'Aceptar',
                    confirmButtonClass: 'btn btn-success',
                    buttonsStyling: false
                }).then(() => swal.noop())
            }
            const err = url.searchParams.get('err');
            if (err) {
                history.replaceState({}, 'BambuCR', '/app/');
                // Evitar ataques xss
                const sanitize = (html) => {
                    const trim = (node) => {
                        $.each(node.attributes, () => {
                            var attrName = this.name;
                            var attrValue = this.value;
                            if (attrName.indexOf('on') == 0 || attrValue.indexOf('javascript:') == 0) {
                                $(node).removeAttr(attrName);
                            }
                        });
                    };
                    const output = $($.parseHTML('<div>' + html + '</div>', null, false));
                    output.find('*').each(function () {
                        trim(this);
                    });
                    return output.html();
                };
                swal({
                    title: 'Error',
                    html: sanitize(err),
                    type: 'error',
                    confirmButtonText: 'Aceptar',
                    confirmButtonClass: 'btn btn-success',
                    buttonsStyling: false
                }).then(() => swal.noop())
            }
            const openHelp = url.searchParams.get('ayuda');
            if (openHelp) {
                history.replaceState({}, 'BambuCR', '/app/');
                modalSupport(21);
            }

        });

        //se llaman en indexJS
        function modalPago(id_company_selected) {
            app.modalPago(id_company_selected);
        }
        function modalPagoWorkgroup(id_company_selected) {
            app.modalPagoWorkgroup(id_company_selected);
        }
        function modalTicket() {
            app.modalTicket();
        }

        async function clearSiteData() {
            //tomar todos los documentos de esta empresa
            const db = app.getDb("dbApp")
            const entries = await db.queue
            .where("accountId")
            .startsWith(uuidCompany.substr(0, 16))
            .toArray();

            const hasNavedi = await app.init_navedi().then(() => true).catch(() => false);//verificar si tiene navedi
            let canClearCache = entries.length > 0 ? hasNavedi : true;
            let doBackup = false;
            if (hasNavedi && entries.length > 0) {
                //crear copia de seguridad
                //guardar en un archivo con navedi
                await navedi.file.write(uuidCompany+"_backup"+'.json',{
                    data:JSON.stringify(entries),
                })
                .catch(e => {
                    console.error(e);
                    canClearCache = false;//ocurrio algun error al guardar copia
                })
                doBackup = true;
            }

            if (!canClearCache) {
                //no se puede eliminar porque hay documentos pendientes
                swal({
                    title:"No se puede eliminar caché",
                    text: `Hay ${entries.length} documentos pendientes en esta empresa. Por favor, diríjase al punto de venta para reenviar o eliminar los documentos correspondientes.`
                })
            } else {
                swal({
                    title: "¿Está seguro?",
                    text: "Se eliminará toda información en caché y se cerrará la sesión",
                    showCancelButton: true,
                    cancelButtonText: "Cancelar",
                    confirmButtonText: "Aceptar"
                })
                .then(() => {
                    let path = "/app/clearSiteData.php";
                    if (doBackup) {
                        path += `?uid=${uuidCompany}`;
                    }
                    window.location.assign(path);
                })
            }

        }
    </script>
