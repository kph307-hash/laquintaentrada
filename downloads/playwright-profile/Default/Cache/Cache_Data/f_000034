    function goToPage(page, method = 'assign', URLparams = null) {

        // if (e) {
        //     method = e.button == 1  ?  "tab" : 'assign'
        // }
        swal_offline(offline_sidebar, page).then(() => {
            const url = 'https://bambucr.app';
            let location_url = url + pages[page];

            if (URLparams) {
                //objeto con los parametros extra a agregar al redireccionamiento
                let UrlObject = new URL(location_url)
                let params = UrlObject.searchParams;
                for (let key in URLparams) {
                    params.append(key, URLparams[key])
                }
                location_url = UrlObject.origin + UrlObject.pathname + '?' + params.toString();
            }
            if (method === 'assign') {
                window.location.assign(location_url);
            } else if (method === 'replace') {
                window.location.replace(location_url);
            } else if (method === 'tab') {
                window.open(location_url, '_blank');
            } else {
                window.open(location_url);
            }
        })
    }

