        $("body").append(`<div id="modalAsignarActividad"></div>`);
        $("#modalAsignarActividad").load("./modal_asignar_actividad.php", {}, () => {
          vAsignarActividad.open([], activitySaveCallback);
        });
      }
    },
    // Función para seleccionar IVA
    seleccion_iva: function () {
      const ivaSaveCallback = (taxId) => {
