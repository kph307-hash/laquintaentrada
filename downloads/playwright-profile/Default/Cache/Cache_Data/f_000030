          return;
        }
        const postData = {
          action: "assignIva",
          payload: JSON.stringify(this.FiltrosParaModificar),
          value: taxId, // El ID del impuesto
        };
        swal({ title: "Asignando IVA...", text: "Aplicando a todos los productos filtrados.", allowOutsideClick: false, onOpen: () => swal.showLoading() });
        $.post(
          "bin/bulk_update_products.php",
          postData,
          (response) => {
            if (response.success) {
              swal.close();
              $.notify("IVA asignado correctamente.", { type: "success" });
              this.loadProducts();
            } else {
              swal("Error", response.error || "Ocurrió un error inesperado.", "error");
            }
          },
          "json",
        ).fail(() => {
          swal("Error", "No se pudo conectar con el servidor.", "error");
        });
      };
      // Verificamos si vAsignarImpuesto ya está definido
      if (typeof vAsignarImpuesto !== "undefined") {
        vAsignarImpuesto.open([], ivaSaveCallback);
      } else {
        // Código de respaldo si vAsignarImpuesto no está inicializado
        $("body").append(`<div id="modalAsignarImpuesto"></div>`);
        $("#modalAsignarImpuesto").load("./modal_asignar_impuesto.php", {}, () => {
          vAsignarImpuesto.open([], ivaSaveCallback);
        });
      }
    },
    // Función para cambiar la categoría de los productos
    cambiar_categoria: function () {
      swal({
        title: "Asignar Categoría",
        html: `
                    <div class="form-group label-floating is-empty">
                        <label class="control-label">Ingrese o seleccione una categoría</label>
                        <datalist id="cat-swal-datalist"></datalist>
                        <input type="text" list="cat-swal-datalist" id="cat-swal-input" class="form-control">
                    </div>
                `,
        onOpen: () => {
          const list = document.getElementById("cat-swal-datalist");
          this.categories.forEach((c) => {
            // Usamos option para que funcione en todos los navegadores
            const element = document.createElement("option");
            element.value = c.name_category;
            list.appendChild(element);
          });
          // Para que el label flotante funcione
          $("#cat-swal-input").focus();
        },
        showCancelButton: true,
        confirmButtonClass: "btn btn-success",
        cancelButtonClass: "btn btn-default",
        confirmButtonText: "Asignar",
        cancelButtonText: "Cancelar",
        buttonsStyling: false,
        preConfirm: () => {
          return new Promise((resolve) => {
            const categoryName = document.getElementById("cat-swal-input").value;
            if (!categoryName || categoryName.trim() === "") {
              swal.showValidationError("Por favor, ingrese un nombre de categoría.");
            } else {
              resolve(categoryName.trim());
            }
          });
        },
      })
        .then((result) => {
          // result contiene el nombre de la categoría si el usuario confirmó
          if (result) {
            const categoryName = result;
            const postData = {
              action: "assignCategory",
              payload: JSON.stringify(this.FiltrosParaModificar),
              value: categoryName,
            };

            swal({
              title: "Asignando Categoría...",
              text: "Aplicando a todos los productos filtrados.",
              allowOutsideClick: false,
              onOpen: () => swal.showLoading(),
            });

            $.post(
              "bin/bulk_update_products.php",
              postData,
              (response) => {
                if (response.success) {
                  swal.close();
                  $.notify("Categoría asignada correctamente.", { type: "success" });
                  this.loadProducts();
                  // Si el backend nos dice que creó una categoría, actualizamos la lista
                  if (response.isNew) {
                    app.syncTables(["categories"]).then(() => {
                      this.getCategories();
                    });
                  }
                } else {
                  swal("Error", response.error || "Ocurrió un error inesperado.", "error");
                }
              },
              "json",
            ).fail(() => {
              swal("Error", "No se pudo conectar con el servidor.", "error");
            });
          }
        })
        .catch(swal.noop);
    },
    resetear_inventario: function () {
      const title = `¿Desea restablecer el inventario a 0 para los ${this.selectAll ? this.totalProductsInFilter : this.selected.length} productos?`;
      const confirmText = `El inventario de los productos ha sido restablecido a 0.`;

      swal({
        title: title,
        text: "Esta acción se aplicará a todos los productos que esten seleccionados. Una vez realizado, NO SE PUEDE DESHACER.",
        type: "warning",
        showCancelButton: true,
        confirmButtonText: "Sí, Restablecer",
        cancelButtonText: "Cancelar",
        confirmButtonClass: "btn btn-danger",
        cancelButtonClass: "btn btn-default",
        buttonsStyling: false,
      })
        .then(() => {
          //preguntar para cual bodega
          if (this.useWarehouses && this.bodegas.length > 1) {
            return swal({
              title: "Seleccione la bodega en la que desea restablecer el inventario a 0. Advertencia: Esta acción no se puede deshacer.",
              input: "select",
              inputOptions: this.bodegas.reduce((obj, b) => {
                obj[b.id] = b.name;
