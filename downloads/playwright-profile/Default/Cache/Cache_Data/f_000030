function redondear_precios() {
  swal({
    title: "¿Esta seguro?",
    text: "Se redondearan los precios de todos los productos, esta accion es irreversible",
    type: "warning",
    showCancelButton: true,
    confirmButtonText: "Si, redondear",
    cancelButtonText: "No, cancelar",
  })
    .then(() => {
      swal({
        title: `<span id="exporter-title">Conectando...</span>`,
        allowOutsideClick: false,
        allowEscapeKey: false,
        showConfirmButton: false,
        animation: false,
        html: `
            <div class="progress progress-line-primary">
                <div id="exporter-percent-bar" class="progress-bar" role="progressbar" style="width: 0%;">
                    <span class="sr-only">0%</span>
                </div>
            </div>`,
      });

      let sse = new EventSource("bin/redondear.php");

      //a message is received
      sse.addEventListener("message", function (e) {
        const result = JSON.parse(e.data);
        if (e.lastEventId == "INFO") {
          $("#exporter-title").text(result.message);
        } else if (e.lastEventId == "CLOSE") {
          //Recibir un CLOSE debe devolver el URL del recurso generado
          sse.close();
          swal.close();
          gridOptions.api.setDatasource(vApp);
        } else if (e.lastEventId == "ERROR") {
          console.log(result.message);
          sse.close();
          swal.close();
        } else {
          $("#exporter-percent-bar").css("width", result.progress + "%");
          $("#exporter-percent-value").text(result.progress + "%");
        }
      });

      sse.addEventListener("error", function (e) {
        sse.close();
        swal.close();
        swal("Ocurrió un error", "No se pudo redondear los precios", "error");
      });
    })
    .catch(swal.noop);
}

const curFormatter = (n) => {
  if (n.data) {
    if (null === n.value || n.value === undefined) {
      return "-";
    }
    const value = parseFloat(n.value);
    if (isNaN(value)) {
      return "-";
    }
    return (n.data.cur !== "USD" ? (!useUSD ? "" : "₡") : "$") + value.toFixed(2).replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1,");
  }
};

const formatterPercentage = (n) => {
  if (n.data) {
    if (n.value === null) {
      return "-";
    }
    const value = parseFloat(n.value);
    return !isNaN(value) ? value.toFixed(2).replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1,") + "%" : "0.00%";
  }
  return "0.00%";
};

