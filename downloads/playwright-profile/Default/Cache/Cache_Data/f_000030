  computed: {
    dynamicBulkActions: function () {
      // Acciones base que casi siempre están disponibles
      const baseActions = [
        { value: "assignCabys", text: "Asignar CABYS", icon: "qr_code_2" },
        { value: "assignActivity", text: "Asignar Actividad", icon: "business_center" },
        { value: "assignIva", text: "Asignar IVA", icon: "percent" },
        { value: "assignCategory", text: "Asignar Categoría", icon: "label" },
        { value: "assignType", text: "Producto o Servicio", icon: "ballot" },
        { value: "assignMaxDiscount", text: "Asignar Descuento Máx.", icon: "local_offer" },
        { value: "resetInventory", text: "Restablecer Inventario", icon: "inventory" },
      ];

      // Si no hay productos seleccionados, no hacemos nada especial.
      if (this.selected.length === 0) {
        return [
          { value: "inactivate", text: "Inactivar", icon: "visibility_off" },
          { value: "delete", text: "Eliminar", icon: "delete_forever" },
          ...baseActions,
        ];
      }

      // Verificamos si CADA producto seleccionado está inactivo ('IN') o eliminado ('DL')
      const allAreInactive = this.selected.every((product) => product.st === "IN" || product.st === "DL");

      if (allAreInactive) {
        // Si todos están inactivos/eliminados, la acción principal es "Activar"
        return [{ value: "activate", text: "Activar", icon: "power_settings_new" }, ...baseActions];
      } else {
        // Si al menos uno está activo, mostramos las opciones de Inactivar y Eliminar
        return [
          { value: "inactivate", text: "Inactivar", icon: "visibility_off" },
          { value: "delete", text: "Eliminar", icon: "delete_forever" },
          ...baseActions,
        ];
      }
    },
    perm_modificar_producto: function () {
      let isa = Number(is_admin);
      if (isa == 1) {
        return 1;
      }
      return this.permisos["modificar_producto"];
    },
    canEdit: function () {
      let r;
      if (this.selected.length === 1) {
        r = true;
        if (this.selected[0].warehouses && this.selected[0].warehouses.length > 0) {
          const warehouses = this.bodegas.filter((b) => this.selected[0].warehouses.includes(parseInt(b.id)) && b.type == 0);
          r = warehouses.some((w) => w.type == 0);
        }
      }
      if (this.typeWarehouse > 1) {
        r = false;
      }
      if (this.inventoryTime) {
        r = false;
      }
      return r;
    },
    use_supplier: function () {
      return product_supplier;
    },
    useWarehouses: function () {
      return useWarehouses;
    },
    canDelete: function () {
      if (this.typeWarehouse == 2) return false;
      return this.canDoBulkActions;
    },
    canDoBulkActions: function () {
      return this.selected.length > 0 && (is_admin || this.perm_modificar_producto > 0);
    },
    canDeactivate: function () {
      // Cuando uno o mas estan activos
      return (
        this.selected.reduce((p, c) => {
          return (p |= c.st === "AC");
        }, false) &&
        (is_admin || this.perm_modificar_producto == 1) &&
        this.typeWarehouse != 2
      );
    },
    canActivate: function () {
      // Cuando todos estan inactivos
      return (
        this.selected.reduce((p, c) => {
          return (p &= c.st !== "AC");
        }, true) &&
        this.selected.length > 0 &&
        (is_admin || this.perm_modificar_producto == 1)
      );
    },
    useShoppingCart: function () {
      return useShoppingCart;
    },
  },
  methods: {
    // Funcion para actualizar el conteo de filas visibles en la grilla
    updateRowCount: function () {
      if (gridOptions.api) {
        this.totalVisibleProducts = gridOptions.api.getDisplayedRowCount();
      }
    },
    // Función para manejar el evento de click en el botón "Seleccionar Todo"
    handleClickSelectAllButton() {
      // cambia el estado de la variable selectAll
      this.selectAll = !this.selectAll;

      // se llama a la función que ya contiene la lógica de selección
      this.toggleSelectAll();
    },
    toggleSelectAll() {
      // Si selectAll es verdadero, seleccionamos todos los productos visibles y abrimos la modal
      // si no, deseleccionamos todos los productos
      if (this.selectAll) {
        this.selectAllVisible();
        this.openBulkActionModal();
      } else {
        this.deselectAll();
      }
    },
    openBulkActionModal() {
      // se limpia la acción seleccionada
      this.bulkActionSelected = "";
      // se muestra el modal
      $("#modal-bulk-actions").modal("show");
    },
    // Función para ejecutar la acción masiva seleccionada
    executeBulkAction(action = null) {
      // Revisamos si se ha pasado una acción, si no, mostramos un mensaje de error
      if (action != null) {
        this.bulkActionSelected = action;
      }
      if (!this.bulkActionSelected) {
        swal("Error", "Por favor, seleccione una acción para aplicar.", "warning");
        return;
      }
      $("#modal-bulk-actions").modal("hide");
      switch (this.bulkActionSelected) {
        case "activate":
          this.ActivarProductos();
          break;
        case "inactivate":
          this.inativar_eliminar_producto(false);
          break;
        case "delete":
          this.inativar_eliminar_producto(true);
          break;
        case "assignCabys":
          this.seleccionar_cabys();
          break;
        case "assignActivity":
          this.seleccionar_actividad();
          break;
        case "assignIva":
          this.seleccion_iva();
          break;
        case "assignCategory":
          this.cambiar_categoria();
          break;
        case "assignType":
          this.cambiar_tipo();
          break;
        case "assignMaxDiscount":
          if (this.use_max_discount) {
            this.seleccionar_maximo_descuento();
          }
          break;
        case "resetInventory":
          if (is_admin) {
            this.resetear_inventario();
          } else {
            swal("Error", "No tiene permisos para restablecer el inventario.", "error");
          }
          break;
        default:
          swal("Error", "Acción masiva no reconocida.", "danger");
      }
    },
    // Selecciona todos los productos visibles en la grilla
    // Esta función se llama cuando el usuario hace click en el botón "Seleccionar Todo"
    selectAllVisible() {
      if (gridOptions.api) {
        gridOptions.api.forEachNode(function (node) {
          node.setSelected(true);
        });
      }
    },
    // Deselecciona todos los productos visibles en la grilla
    // Esta función se llama cuando el usuario hace click en el botón "Deseleccionar Todo"
    deselectAll() {
      if (gridOptions.api) {
        gridOptions.api.forEachNode(function (node) {
          node.setSelected(false);
        });
      }
    },
    // Funcion para activar los productos seleccionados
    // Esta función se llama cuando el usuario hace click en el botón "Activar Productos"
    ActivarProductos: function () {
      const title = `¿Desea activar los ${this.selectAll ? this.totalProductsInFilter : this.selected.length} productos?`;
      const confirmText = `Los productos han sido activados.`;

      swal({
        title: title,
        text: "Esta acción se aplicará a todos los productos que esten seleccionados",
        type: "warning",
        showCancelButton: true,
        confirmButtonText: "Sí, Activar",
        cancelButtonText: "Cancelar",
        confirmButtonClass: "btn btn-success",
        cancelButtonClass: "btn btn-default",
        buttonsStyling: false,
      })
        .then(() => {
          // Preparamos los datos para enviar al backend
          const postData = {
            action: "activate", // Le decimos al backend qué hacer
            payload: JSON.stringify(this.FiltrosParaModificar),
          };

          swal.showLoading();

          $.post(
            "bin/bulk_update_products.php",
            postData,
            (response) => {
              if (response.success) {
                $.notify(confirmText, { type: "success" });
                this.loadProducts(); // Recargamos la grilla
              } else {
                swal("Error", response.error || "Ocurrió un error inesperado.", "error");
              }
            },
            "json",
          ).fail(() => {
            swal("Error", "No se pudo conectar con el servidor.", "error");
          });
        })
        .catch(swal.noop);
    },
    // Función para inactivar o eliminar productos seleccionados
    inativar_eliminar_producto: function (del = false) {
      // Determinar la acción y el texto a mostrar
      const isDeleting = del;
      const actionText = isDeleting ? "eliminar" : "inactivar";
      const actionPastTense = isDeleting ? "eliminados" : "inactivados";

      // Determinar el número de productos afectados
      // Si 'selectAll' está activo, usamos el total de filtros; si no, el total de la selección manual.
      const totalCount = this.selectAll ? this.totalProductsInFilter : this.selected.length;

      if (totalCount === 0) {
        swal("Atención", "No ha seleccionado productos para " + actionText + ".", "info");
        return;
      }

      // Mostrar el diálogo de confirmación al usuario
      swal({
        title: `¿Desea ${actionText} ${totalCount} productos${this.bodega_seleccionada == 0 ? " de todas las bodegas" : ""}?`,
        text: this.selectAll ? "Esta acción se aplicará a todos los productos que esten seleccionados" : "",
        type: "warning",
        showCancelButton: true,
        confirmButtonText: "Sí, " + actionText.charAt(0).toUpperCase() + actionText.slice(1),
        cancelButtonText: "Cancelar",
        confirmButtonClass: "btn btn-danger",
        cancelButtonClass: "btn btn-default",
        buttonsStyling: false,
      })
        .then(async () => {
          let deleteOption = 1;
          if (isDeleting && this.bodega_seleccionada != 0) {
            deleteOption = await swal({
              title: `Seleccione una opción para ${actionText}:`,
              input: "radio",
              inputOptions: {
                1: "Eliminar de todas las bodegas",
                0: "Eliminar solo en esta bodega",
              },
              inputValue: deleteOption,
              confirmButtonClass: "btn btn-success",
              confirmButtonText: "Aceptar",
              buttonsStyling: false,
              showCancelButton: true,
              cancelButtonText: "Cancelar",
              cancelButtonClass: "btn",
              inputValidator: (radio) => {
                return new Promise((resolve, reject) => {
                  if (!radio) {
                    reject("Selecciona una opción");
                  }

                  resolve(radio);
                });
              },
            })
              .then((result) => result)
              .catch(() => null);

            if (deleteOption === null) {
              return;
            }
          }
          app.modalCargando(true);
          // Preparar los datos para enviar al backend
          const postData = {
            action: isDeleting ? "delete" : "inactivate",
            // El payload SIEMPRE son los filtros.
            payload: JSON.stringify(this.FiltrosParaModificar),
            deleteAction: deleteOption, // Solo relevante si se está eliminando
          };

          // Realizar la llamada AJAX al script unificado
          $.post(
            "bin/bulk_update_products.php",
            postData,
            (response) => {
              if (response.success) {
                $.notify(`Los productos han sido ${actionPastTense}.`, { type: "success" });
                this.loadProducts(); // Recargamos la grilla para ver los cambios
                app.syncTables(["products", "inventories", "warehouses"]).catch((e) => console.error(e));
              } else {
                swal("Error", response.error || "Ocurrió un error inesperado.", "error");
              }
            },
            "json",
          )
            .fail(() => {
              swal("Error", "No se pudo conectar con el servidor.", "error");
            })
            .always(() => {
              app.modalCargando(false);
            });
        })
        .catch(swal.noop);
    },
    // Función para seleccionar CABYS
    seleccionar_cabys: function () {
      // Función "callback" que se le pasa a la modal.
      // El modal la ejecutará cuando el usuario presione "Seleccionar".
      const cabysSaveCallback = (cabys_devueltos) => {
        // Validacion por si el usuario no selecciono ningun CABYS
        if (!cabys_devueltos["cabys"]?.trim() || cabys_devueltos["id_iva"] == null) {
          return;
        }
        // Preparamos los datos para enviar al backend.
        const postData = {
          action: "assignCabys",
          payload: JSON.stringify(this.FiltrosParaModificar),
          value: JSON.stringify(cabys_devueltos), // El valor que nos devolvió el modal.
        };

        swal({ title: "Asignando CABYS...", text: "Aplicando a todos los productos filtrados.", allowOutsideClick: false, onOpen: () => swal.showLoading() });

        // Enviamos los datos al backend unificado.
        $.post(
          "bin/bulk_update_products.php",
          postData,
          (response) => {
            if (response.success) {
              swal.close();
              $.notify("CABYS asignado correctamente.", { type: "success" });
              this.loadProducts(); // Actualizamos la tabla
            } else {
              swal("Error", response.error || "Ocurrió un error inesperado.", "error");
            }
          },
          "json",
        ).fail(() => {
          swal("Error", "No se pudo conectar con el servidor.", "error");
        });
      };

      // Abrimos el modal de CABYS.
      // Se pasa `cabysSaveCallback` como el cuarto argumento (onSave).
      if (typeof vCabys !== "undefined") {
        vCabys.open(
          [], // ids: array vacío, la acción es por filtros
          "", // selection: sin selección inicial
          "productos", // app
          cabysSaveCallback, // onSave: el callback que se creó
          "Asignación masiva a todos los productos filtrados", // descripción
        );
      } else {
        // Código de respaldo si vCabys no está inicializado
        $("body").append(`<div id="modalCabys"></div>`);
        $("#modalCabys").load("./modal_cabys.php", {}, function () {
          vCabys.open([], "", "productos", cabysSaveCallback, "Asignación masiva a todos los productos filtrados");
        });
      }
    },
    // Función para seleccionar una actividad
