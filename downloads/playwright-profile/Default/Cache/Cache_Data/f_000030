function getCharCodeFromEvent(event) {
  event = event || window.event;
  return typeof event.which == "undefined" ? event.keyCode : event.which;
}

function isCharNumeric(charStr) {
  return !!/[-\d.]/.test(charStr);
}

function isKeyPressedNumeric(event) {
  var charCode = getCharCodeFromEvent(event);
  var charStr = String.fromCharCode(charCode);
  return isCharNumeric(charStr);
}
// function to act as a class
function NumericCellEditor() {}

// gets called once before the renderer is used
NumericCellEditor.prototype.init = async function (p) {
  // create the cell
  this.eInput = document.createElement("input");
  this.eInput.className = "ag-input-field-input ag-text-field-input text-right";
  this.eInput.type = "number";

  if (isCharNumeric(p.charPress)) {
    this.eInput.value = p.charPress;
    this.selectInput = false;
  } else {
    this.selectInput = true;
    if (p.value !== undefined && p.value !== null) {
      this.eInput.value = parseFloat(p.value);
    }
  }

  if (vApp.typeWarehouse == 2 && p.column.colId == "qty" && p.value < 0) {
    modificandoCantidadApartado = true;
    this.eInput.disabled = true;
    let res = await fetch("bin/get_productos_apartados.php?id=" + p.data.id);
    let data = await res.json();
    let totalApartado = data.qtyApartadoEnCredito + data.qtyApartadoEnProforma;
    let diferencia = Math.abs(totalApartado - p.data.qty);
    if (totalApartado == 0 || p.data.qty == totalApartado) {
      modificandoCantidadApartado = false;
      this.cancelBeforeStart = true;
      return;
    }
    try {
      await swal({
        title: "¿Deseas modificar la cantidad?",
        html: `
                    El producto <b>${p.data.cdg}/${p.data.dsc}</b> tiene <b>${totalApartado}</b> unidad${totalApartado > 1 ? "es" : ""} apartada${totalApartado > 1 ? "s" : ""}.
                    <br>
                    <br>
                    <b>${data.qtyApartadoEnCredito}</b> apartada${data.qtyApartadoEnCredito > 1 ? "s" : ""} en créditos
                    <br>
                    <b>${data.qtyApartadoEnProforma}</b> apartada${data.qtyApartadoEnProforma > 1 ? "s" : ""} en proformas
                    <br>
                    <br>
                    La diferencia es de <b>${diferencia}</b> unidad${diferencia > 1 ? "es" : ""}.
                `,
        showCancelButton: true,
        confirmButtonText: "Modificar",
        cancelButtonText: "Cancelar",
      });
      this.eInput.value = totalApartado;
    } catch (e) {
      modificandoCantidadApartado = false;
      this.cancelBeforeStart = true;

      console.error(e);
      return;
    }
  }

  var that = this;
  this.eInput.addEventListener("keypress", function (event) {
    if (!isKeyPressedNumeric(event)) {
      that.eInput.focus();
      if (event.preventDefault) event.preventDefault();
    } else if (that.isKeyPressedNavigation(event)) {
      event.stopPropagation();
    }
  });

  // only start edit if key pressed is a number, not a letter
  var charPressIsNotANumber = p.charPress && "-1234567890.".indexOf(p.charPress) < 0;
  this.cancelBeforeStart = charPressIsNotANumber || p.value == "-" || p.value == null || (p.column.colId == "qty" && p.data.tallas > 1);
  this.allowNegativeNumbers = p.column.colId == "qty" || p.column.colId == "ut1";
};

NumericCellEditor.prototype.isKeyPressedNavigation = function (event) {
  return event.keyCode === 39 || event.keyCode === 37;
};

// gets called once when grid ready to insert the element
NumericCellEditor.prototype.getGui = function () {
  return this.eInput;
};

// focus and select can be done after the gui is attached
NumericCellEditor.prototype.afterGuiAttached = function () {
  this.eInput.focus();
  if (this.selectInput) this.eInput.select();
};

// returns the new value after editing
NumericCellEditor.prototype.isCancelBeforeStart = function () {
  return this.cancelBeforeStart;
};

NumericCellEditor.prototype.isCancelAfterEnd = function () {
  var value = this.getValue();
  return !(this.allowNegativeNumbers || value > 0);
};

// returns the new value after editing
NumericCellEditor.prototype.getValue = function () {
  return this.eInput.value;
};

// ---- Selectpicker para usar dentro de las celdas
function SelectCellEditor() {}

SelectCellEditor.prototype.init = function (params) {
  // create the cell
  if (params.column.colId == "ptx") {
    this.eInput = document.getElementById("select-tax-editor-gui").content.cloneNode(true);
  } else if (params.column.colId == "cat") {
    this.eInput = document.getElementById("select-cat-editor-gui").content.cloneNode(true);
  }
  this.width = params.column.actualWidth - 2;
  this.options = {};
  var options = this.eInput.querySelectorAll("option");
  for (let o of options) {
    this.options[o.value] = o.text;
    if (o.text == params.value) {
      o.setAttribute("selected", "true");
    }
  }
  this.cancelBeforeStart = options.length < 2;
  this.stopEditing = params.stopEditing;
  this.data = params.data;

  this.eInput.addEventListener("keypress", function (event) {
    var kc = event.keyCode;
    console.log(kc);
    var prevent = kc == 37 || kc == 39 || kc == 13;
    if (prevent) {
      event.stopPropagation();
    }
  });
};

SelectCellEditor.prototype.getGui = function () {
  return this.eInput;
};

SelectCellEditor.prototype.afterGuiAttached = function () {
  this.el = $("#ag-select-tax-editor");
  var w = this.width;
  this.el.parent().parent().width(w);
  this.el.selectpicker();
  this.el.selectpicker("toggle");
  this.el.on("changed.bs.select", () => {
    this.stopEditing();
  });
};

SelectCellEditor.prototype.isCancelBeforeStart = function () {
  return this.cancelBeforeStart;
};

SelectCellEditor.prototype.getValue = function () {
  this.data.value = this.el.val();
  return this.options[this.el.val()];
};

SelectCellEditor.prototype.destroy = function () {
  this.el.selectpicker("destroy");
};

SelectCellEditor.prototype.isPopup = function () {
  return true;
};

