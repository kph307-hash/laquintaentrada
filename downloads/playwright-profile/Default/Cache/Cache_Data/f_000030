// Modal para selección de columnas a mostrar
(() => {
  // Cargar preferencias desde localStorage o usar valores por defecto
  const getInitialColumns = () => {
    const storagePath = `${idCompany}_${idUser}_product_list_columns`;
    const saved = localStorage.getItem(storagePath);
    
    if (saved) {
      return JSON.parse(saved);
    }
    
    // Valores por defecto: mostrar todas las columnas que no estén ocultas por reglas de negocio
    const defaults = {};
    window.productColumnDefs.forEach(col => {
      if (col.field) {
        defaults[col.field] = !col.hideByBusinessRule;
      }
    });
    return defaults;
  };
  
  new Vue({
    el: "#modal_column_settings",
    data: {
      columns: getInitialColumns(),
      maxColumns: 15, // Límite máximo de columnas seleccionadas
      minColumns: 1,  // Mínimo de columnas seleccionadas
      errorMessage: '', // Mensaje de error inline
    },
    computed: {
      availableColumns: function() {
        // Genera dinámicamente la lista de columnas disponibles
        // basándose en columnDefs, filtrando por hideByBusinessRule
        if (!window.productColumnDefs) return [];
        
        return window.productColumnDefs
          .filter(col => col.field && col.headerName && !col.hideByBusinessRule)
          .map(col => ({
            field: col.field,
            label: col.headerName
          }));
      },
      selectedCount: function() {
        // Contar columnas seleccionadas
        return Object.values(this.columns).filter(val => val === 1 || val === true).length;
      },
      isAtMaxLimit: function() {
        return this.selectedCount >= this.maxColumns;
      },
      isAtMinLimit: function() {
        return this.selectedCount <= this.minColumns;
      }
    },
    methods: {
      saveColumns: function () {
        // Guardar en localStorage usando el patrón del proyecto
        const storagePath = `${idCompany}_${idUser}_product_list_columns`;
        localStorage.setItem(storagePath, JSON.stringify(this.columns));
      },
      resetToDefaults: function() {
        // Valores por defecto: 15 columnas específicas
        const defaults = {
          imgs: 1,
          cbs: 1,
          cdg: 1,
          cat: 1,
          dsc: 1,
          nsp: 1,
          qty: 1,
          mel: 0,
          ipt: 0,
          ct: 1,
          ptx: 1,
          atx1: 1,
          ut1: 1,
          p1: 1,
          ut2: 0,
          mrgn2: 0,
          atx2: 0,
          p2: 0,
          ut3: 0,
          mrgn3: 0,
          atx3: 0,
          p3: 0,
          pr: 1,
          mrgn1: 1,
          lst_updt: 1
        };
        
        // Restablecer columnas a valores por defecto
        Object.keys(defaults).forEach(key => {
          this.$set(this.columns, key, defaults[key]);
        });
        
        // Actualizar grid y guardar
        this.updateGridColumns();
        this.saveColumns();
        
        // Notificar al usuario
        $.notify('Columnas restablecidas a configuración por defecto', {
          type: 'success',
          delay: 2000
        });
      },
      toggleColumn: function(field) {
        const currentValue = this.columns[field];
        
        // Si intenta desactivar y solo queda 1 columna
        if (currentValue && this.isAtMinLimit) {
          this.errorMessage = 'Debe mantener al menos una columna visible';
          setTimeout(() => { this.errorMessage = ''; }, 3000);
          return;
        }
        
        // Si intenta activar y ya llegó al máximo
        if (!currentValue && this.isAtMaxLimit) {
          this.errorMessage = `Máximo ${this.maxColumns} columnas permitidas`;
          setTimeout(() => { this.errorMessage = ''; }, 3000);
          return;
        }
        
        // Limpiar error si existe
        this.errorMessage = '';
        
        // Cambiar el valor
        this.$set(this.columns, field, currentValue ? 0 : 1);
        
        // Actualizar grid y guardar
        this.updateGridColumns();
        this.saveColumns();
      },
      updateGridColumns: function() {
        // Actualizar hideInTable y hide en columnDefs
        window.productColumnDefs.forEach(col => {
          if (col.field && this.columns.hasOwnProperty(col.field)) {
            col.hideInTable = !this.columns[col.field];
            // IMPORTANTE: hide debe respetar SIEMPRE hideByBusinessRule primero
            col.hide = col.hideByBusinessRule || col.hideInTable;
          }
        });
        
        // Actualizar las columnas del grid
        const columnsToShow = [];
        const columnsToHide = [];
        
        Object.keys(this.columns).forEach(field => {
          const columnDef = gridOptions.columnApi.getColumn(field);
          const colDefData = window.productColumnDefs.find(c => c.field === field);
          
          if (columnDef && colDefData) {
            // Solo mostrar si: 1) usuario quiere verla Y 2) tiene permiso (hideByBusinessRule === false)
            if (this.columns[field] && !colDefData.hideByBusinessRule) {
              columnsToShow.push(field);
            } else {
              columnsToHide.push(field);
            }
          }
        });
        
        if (columnsToShow.length > 0) {
          gridOptions.columnApi.setColumnsVisible(columnsToShow, true);
        }
        if (columnsToHide.length > 0) {
          gridOptions.columnApi.setColumnsVisible(columnsToHide, false);
        }
      }
    }
  });
})();
