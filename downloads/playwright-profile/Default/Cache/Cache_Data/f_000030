Vue.component("vue-supplier-autocomplete", {
  props: ["value"],
  template: `<input
        v-bind:value="value"
        v-on:input="$emit('input', $event.target.value)"
        v-on:click="$el.select()"
        type="text"
        class="form-control">`,
  mounted: function () {
    const vm = this;
    $(this.$el).autocomplete({
      lookup: function (query, done) {
        supplierAutocomplete(query).then((r) => done(r));
      },
      onSelect: function (s) {
        vm.$emit("input", s.value);
      },
      formatResult: function (s, v) {
        const item = s.data;
        const sug = `${item.cdg}/${item.nm}`;
        return sug.replace(RegExp(v, "gi"), function (x) {
          return `<strong>${x}</strong>`;
        });
      },
    });
  },
});

