    delProd: function (del = false) {
      const data = gridOptions.api.getSelectedRows();
      const idsSelected = data.map((p) => p.id);
      const cdgSelected = data.map((p) => p.cdg);
      //si  algun cdg es "SERV-CL", "SERV-RE", "SERV-RG", "SERV-EX" no se puede eliminar
      //hay un cliente que los pasaba eliminando y luego le daba problemas con el sistema
      if (cdgSelected.some((cdg) => ["SERV-CL", "SERV-RE", "SERV-RG", "SERV-EX"].includes(cdg))) {
        //no dejar eliminar
        swal({
          title: "¡Error!",
          text: "No se puede eliminar el producto (SERV-CL, SERV-RE, SERV-RG, SERV-EX) porque es un servicio fundamental del sistema.",
          type: "error",
          confirmButtonClass: "btn btn-danger",
          confirmButtonText: "Aceptar",
          buttonsStyling: false,
        }).catch(swal.noop);
        return;
      }
      let actionTitle = del ? "¿Desea eliminar" : "¿Desea inactivar";
      let confirmText;
      if (idsSelected.length == 1) {
        const t = data[0].tp;
        actionTitle += t == 1 ? " el producto?" : " el servicio?";
        confirmText = "El " + (t == 1 ? "producto" : "servicio") + " ha sido " + (del ? "eliminado." : "inactivado.");
      } else {
        actionTitle += " los " + idsSelected.length + " productos?";
        confirmText = "Los productos han sido " + (del ? "eliminados." : "inactivados.");
      }
      swal({
        title: actionTitle,
        type: "warning",
        showCancelButton: true,
        confirmButtonText: "Aceptar",
        cancelButtonText: "Cancelar",
        confirmButtonClass: "btn btn-danger",
        cancelButtonClass: "btn btn-default",
        buttonsStyling: false,
      })
        .then(function () {
          const consultar = (deleteFromAll = null) => {
            var data = {
              delete: del ? "true" : "false",
              data: JSON.stringify(idsSelected),
            };

            if (deleteFromAll !== null) {
              data.deleteFromAll = deleteFromAll;
            }
            $.post("./bin/delete.php", data, function (d, s) {
              if (d.error == "product_in_more_warehouses") {
                swal({
                  title: `${idsSelected.length > 1 ? "Uno de los productos" : "El producto"} existe en mas de una bodega`,
                  input: "radio",
                  inputOptions: {
                    1: "Eliminar de todas las bodegas",
                    0: "Eliminar solo en esta bodega",
                  },
                  confirmButtonClass: "btn btn-success",
                  confirmButtonText: "Aceptar",
                  buttonsStyling: false,
                  showCancelButton: true,
                  cancelButtonText: "Cancelar",
                  cancelButtonClass: "btn",
                  inputValidator: (radio) => {
                    return new Promise((resolve, reject) => {
                      if (!radio) {
                        reject("Selecciona una opción");
                      }

                      resolve(radio);
                    });
                  },
                })
                  .then((radio) => {
                    consultar(radio == 1);
                  })
                  .catch(swal.noop);
              } else {
                if (s === "success") {
                  vApp.loadProducts();
                  app.syncTables(["products", "inventories", "warehouses"]).catch((e) => console.error(e));
                  swal({
                    title: del ? "¡Eliminado!" : "¡Inactivado!",
                    text: confirmText,
                    type: "success",
                    confirmButtonClass: "btn btn-success",
                    confirmButtonText: "Aceptar",
                    buttonsStyling: false,
                  }).catch(swal.noop);
                }
              }
            });
          };
          consultar();
        })
        .catch(swal.noop);
    },
