const modalApartados = new Vue({
  name: "Modal utilizados",
  el: "#modal-utilizados",
  data: {
    list: [], //lista de facturas utilizados,
    producto: {}, //datos de producto seleccionado
    loading: false,
    date_from: moment().format("l"),
    date_to: moment().format("l"),
    label_date: "Documentos de hoy",
    last_bill_sale: "",
    encontro_facturas: false,
    error: "",
  },
  methods: {
    open: function (producto) {
      this.producto = producto;
      $(this.$el).modal("show");
      this.getLista(this.producto);
      setTimeout(function () {
        $(".selectpicker").selectpicker("refresh");
      }, 750);
    },
    curFormat: function (m) {
      return Number.parseFloat(m)
        .toFixed(2)
        .replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1,");
    },
    getLista: function () {
      this.encontro_facturas = false;
      const form = new FormData();
      form.append("id", this.producto.id);
      form.append("date_from", this.date_from);
      form.append("date_to", this.date_to);
      this.loading = true;
      this.error = "";
      fetch("bin/lista_apartados.php", {
        method: "POST",
        date_from: this.date_from,
        date_to: this.date_to,
        body: form,
      })
        .then((res) => {
          if (!res.ok) {
            throw new Error("Error de servidor");
          }
          return res.json();
        })
        .then((data) => {
          this.list = data.list;
          this.encontro_facturas = data.encontro;
          this.last_bill_sale = data.last_bill_sale;
        })
        .catch((e) => {
          console.error(e);
          this.error = "Ocurrio un error al cargar las facturas apartadas";
        })
        .finally(() => {
          this.loading = false;
        });
    },
    tipo_factura: function (type) {
      if (type == 1) {
        return "Contado";
      } else if (type == 2) {
        return "Crédito";
      } else if (type == 3) {
        return "Abono";
      } else if (type == 4) {
        return "Proforma";
      } else {
        return "Indefinido" + type;
      }
    },
    update_date_filter_label: function () {
      var label;
      if (this.date_from && this.date_to == "") {
        label = `desde ${this.date_from}`;
      } else if (this.date_from == "" && this.date_to) {
        label = `hasta ${this.date_to}`;
      } else if (this.date_from == "" && this.date_to == "") {
        label = "Todo";
      } else {
        label = `desde ${this.date_from} hasta ${this.date_to}`;
      }

      if (label) {
        this.label_date = label;
      }
    },
    setTime: function (n) {
      var label;
      var datepicker;
      var datepicker2;
      switch (n) {
        case 1:
          //hoy
          datepicker = moment().format("L");
          label = "Documentos de hoy";
          break;

        case 2:
          //ayer
          datepicker = datepicker2 = moment().subtract(1, "days").format("L");
          label = "Documentos de ayer";
          break;

        case 3:
          //esta semana
          datepicker = moment().startOf("week").format("L");
          label = "Documentos de esta semana";
          break;

        case 4:
          // semana anterior
          datepicker = moment().subtract(1, "weeks").startOf("week").format("L");
          datepicker2 = moment().subtract(1, "weeks").endOf("week").format("L");
          label = "Documentos de la semana anterior";
          break;

        case 5:
          //este mes
          datepicker = moment().startOf("month").format("L");
          label = "Documentos de este mes";
          break;

        case 6:
          //mes anterior
          datepicker = moment().subtract(1, "months").startOf("month").format("L");
          datepicker2 = moment().subtract(1, "months").endOf("month").format("L");
          label = "Documentos del mes anterior";
          break;

        case 7:
          //este año
          datepicker = moment().startOf("year").format("L");
          label = "Documentos de este año";
          break;

        case 8:
          //año anterior
          datepicker = moment().subtract(1, "years").startOf("year").format("L");
          datepicker2 = moment().subtract(1, "years").endOf("year").format("L");
          label = "Documentos del año anterior";
          break;
      }
      if (n % 2 == 1 && n != 9) {
        datepicker2 = moment().format("L");
      }
      this.label_date = label;
      this.date_from = datepicker;
      this.date_to = datepicker2;
    },
    open_preview: function (idFactura) {
      id_documento_elegido = idFactura;
