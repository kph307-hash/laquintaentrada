    //<button @click="iniciarEscucha('product_search')">Hablar</button>
    iniciarEscucha: function (tipo = "") {
      const mostrarError = (mensajeExtra = "") => {
        let mensaje = "⚠️ No se pudo iniciar el reconocimiento de voz.";
        if (mensajeExtra) mensaje += " " + mensajeExtra;
        $.notify(mensaje, { type: "danger" });
      };

      // Validar soporte
      if (typeof webkitSpeechRecognition === "undefined") {
        mostrarError("Tu navegador no soporta reconocimiento de voz.");
        return;
      }

      try {
        const reconocimiento = new webkitSpeechRecognition();
        reconocimiento.lang = "es-ES";
        reconocimiento.continuous = false;
        reconocimiento.interimResults = true;

        this.reconocimiento = reconocimiento;

        if (tipo === "product_search") {
          this.escuchandoProducto = true;
          this.textoEscuchado = "";

          reconocimiento.onresult = (event) => {
            let texto = "";
            for (let i = event.resultIndex; i < event.results.length; ++i) {
              texto += event.results[i][0].transcript + " ";
            }
            this.textoEscuchado = texto.trim();
          };

          reconocimiento.onend = () => {
            this.product = this.textoEscuchado;
            this.escuchandoProducto = false;
            this.reconocimiento = null;
            this.loadProducts();
          };

          reconocimiento.onerror = (e) => {
            let razon = e.error;
            let explicacion = "";

            switch (razon) {
              case "not-allowed":
                explicacion = "El navegador no tiene permiso para usar el micrófono. Activá los permisos en la parte superior del navegador.";
                break;
              case "aborted":
                explicacion = "El acceso al micrófono fue cancelado.";
                break;
              case "no-speech":
                explicacion = "No se detectó ninguna voz. Probá hablar más cerca del micrófono.";
                break;
              case "audio-capture":
                explicacion = "No se detectó ningún micrófono. Asegurate de tener uno conectado.";
                break;
              default:
                explicacion = "Error desconocido: " + razon;
                break;
            }

            mostrarError(explicacion);
            console.error("Error reconocimiento:", e);
            this.escuchandoProducto = false;
            this.reconocimiento = null;
          };

          reconocimiento.start();
        } else {
          reconocimiento.onresult = (event) => {
            const texto = event.results[0][0].transcript.toLowerCase();
            console.log("🗣️ Dijo:", texto);

            if (texto.includes("inventario de galletas")) {
              this.hablar("¿Cuánto es el inventario actual de galletas?");
            } else if (texto.includes("guardar inventario")) {
              this.hablar("Inventario guardado con éxito.");
            } else {
              this.hablar("No entendí lo que dijiste.");
            }
          };

          reconocimiento.onerror = (e) => {
            let explicacion = e.error === "not-allowed" ? "No se tienen permisos para usar el micrófono." : "Ocurrió un error con el reconocimiento de voz.";
            mostrarError(explicacion);
            console.error("Error reconocimiento:", e);
          };

          reconocimiento.onend = () => {
            this.reconocimiento = null;
          };

          reconocimiento.start();
        }
      } catch (error) {
        mostrarError("Tu navegador no permite el uso del micrófono o ha ocurrido un fallo inesperado.");
        console.error("Error general al iniciar reconocimiento:", error);
      }
    },
    cancelarEscuchaProducto() {
      if (this.reconocimiento) {
        this.reconocimiento.stop();
        this.reconocimiento = null;
      }
      this.escuchandoProducto = false;
    },
