      const activitySaveCallback = (activityCode) => {
        if (!activityCode) {
          swal("Cancelado", "No se seleccionó ninguna actividad.", "info");
          return;
        }
        const postData = {
          action: "assignActivity",
          payload: JSON.stringify(this.FiltrosParaModificar),
          value: activityCode,
        };
        swal({
          title: "Asignando Actividad...",
          text: "Aplicando a todos los productos filtrados.",
          allowOutsideClick: false,
          onOpen: () => swal.showLoading(),
        });
        $.post(
          "bin/bulk_update_products.php",
          postData,
          (response) => {
            if (response.success) {
              swal.close();
              $.notify("Actividad asignada correctamente.", { type: "success" });
              this.loadProducts();
            } else {
              swal("Error", response.error || "Ocurrió un error inesperado.", "error");
            }
          },
          "json",
        ).fail(() => {
          swal("Error", "No se pudo conectar con el servidor.", "error");
        });
      };
      // Verificamos si vAsignarActividad ya está definido
      if (typeof vAsignarActividad !== "undefined") {
        vAsignarActividad.open([], activitySaveCallback);
