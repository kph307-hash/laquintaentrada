let ignoreCellChange = false;
const gridOptions = {
  undoRedoCellEditing: true,
  columnDefs: columnDefs,
  rowModelType: "infinite",
  datasource: vApp,
  maxConcurrentDatasourceRequests: 1,
  rowBuffer: 0,
  rowSelection,
  getRowNodeId: function (item) {
    return item.id.toString();
  },
  rowMultiSelectWithClick: isAndroid,
  maxBlocksInCache: 10,
  cacheBlockSize: 50,
  onSelectionChanged: vApp.updateRowOptions,
  rowClassRules: {
    "ag-inactive-product": function (params) {
      return params.data ? params.data.st === "IN" : false;
    },
    "ag-delete-product": function (params) {
      return params.data ? params.data.st === "DL" : false;
    },
  },
  rowHeight: 32,
  headerHeight: 48,
  components: {
    numericCellEditor: NumericCellEditor,
    selectCellEditor: SelectCellEditor,
  },
  onCellValueChanged: async function (event) {
    const data = event.data;
    if (ignoreCellChange) {
      ignoreCellChange = false;
      return;
    }
    if (event.oldValue == event.newValue) return;
    let pasa = true;
    if ((permisos["modificar_producto"] == 0 || permisos["modificar_producto"] == 2) && !is_admin) {
      pasa = false;
      await app
        .requestAuth(
          "admin",
          "No tienes los permisos para modificar productos y servicios. Necesitas una contraseña brindada por un administrador para completar la acción.",
          "12",
          data.cdg,
          0,
          data.cdg,
        )
        .then((a) => {
          if (a) {
            pasa = true;
          } else {
            pasa = false;
          }
        });
    }
    if (!pasa) {
      vApp.loadProducts();
      return;
    }
    const colId = event.column.colId;
    if (
      (colId == "qty" && vApp.typeWarehouse > 1 && !modificandoCantidadApartado) ||
      (colId == "qty" && vApp.typeWarehouse == 2) ||
      (colId == "qty" && vApp.typeWarehouse == 1)
    ) {
      $.notify("No se puede modificar la cantidad de productos en bodegas de tipo " + (vApp.typeWarehouse == 1 ? "camión" : "apartado"), { type: "danger" });
      vApp.loadProducts();
      return;
    }
    modificandoCantidadApartado = false;

    const showError = (e) => {
      if (e) {
        console.error(e.message);
        $.notify(e.message, { type: "danger" });
      } else {
        console.error("Ocurrio un error al actualizar el articulo " + data.cdg + "/" + data.dsc);
      }
    };
    const ajax_func = (razon = "") => {
      const body = new FormData();
      body.append("id", data.id);
      body.append("col", colId);
      body.append("value", colId === "cat" || colId === "ptx" || colId === "ut1" ? data.value : data[colId]);
      body.append("reason", razon);
      fetch("bin/actions_inventory.php", {
        method: "POST",
        body,
      })
        .then((r) => r.json())
        .then((d) => {
          if (d.error) {
            showError(d.error);
          } else {
            $.notify("El producto <b>" + data.cdg + "/" + data.dsc + "</b> fue modificado exitosamente.", { type: "success" });
            gridOptions.api.getRowNode(d.product.id.toString()).setData(d.product);
          }
        })
        .catch((e) => {
          showError(e.message);
        });
    };
    if (colId == "qty" && reason_mod_product) {
      app.auth_qty_mod().then((razon) => {
        if (razon) {
          ajax_func(razon);
        } else {
          //devolver al valor original
          vApp.loadProducts();
          // gridOptions.api.getRowNode(data.id.toString()).setDataValue('qty', event.oldValue );
        }
      });
    } else if (colId == "dsc") {
      if (event.newValue.trim() == "") {
        $.notify("La descripcion no puede estar vacia", {
          type: "danger",
        });
        gridOptions.api.getRowNode(data.id.toString()).setDataValue("dsc", event.oldValue); //al llamar esto vuelve a llamar esta funcion
        ignoreCellChange = true; //asi que ponemos una flag para que la ignore
        return;
      }
      ajax_func();
    } else {
      ajax_func();
    }
  },
  onModelUpdated: function () {
    // Si selectAll está activo, selecciona todas las filas visibles
    if (vApp.selectAll && gridOptions.api) {
      gridOptions.api.forEachNode(function (node) {
        node.setSelected(true);
      });
    }
    vApp.updateRowCount(); // Actualiza el contador DESPUÉS de filtrar/ordenar
  },
  onGridReady: function (params) {
    // Ordenar por código cuando se cargue por primera vez la página
    params.api.setSortModel([{ colId: "cdg", sort: "asc" }]);
    vApp.updateRowCount(); // Actualiza el contador al cargar
  },
};

