
export default {
    data() {
        return{
            show_product: false,
            show_provider: false,
            show_clientes: false,
            show_stock: false,
            show_utilidad: false,
            type: 'bar',
            myBarChart: '',
            show_graph: true,
            labels: [],
            data: [],
            fullLabels: [],
            stock: [],
            title: '',
            date_range: 0,
            filter_graph: 1,
            inventory_cost: 0,
            inventory_sale: 0,
            company_scope: `company:${idCompany}`,
            company_scope_options: [],
        }
    },
    template:
        `<div class="card" id="vGraphic"  style="margin: 0px;margin-bottom:80px;">
            <div class="row col-md-12" style="padding-right: 0px!important;">
                <div class="card-content" style="padding: 15px 15px 15px 30px!important;">
                    <!-- graphics -->
                    <div class="row table-responsive">
                        <div class="col-md-12">
                            <div>
                                <div v-if="show_graph" class="text-center" style="position: relative; height: 400px;">
                                    <canvas class="chart-container" id="myBarChart" style="width: 100% !important; height: 100% !important; max-width: 100%;"></canvas>
                                </div>
                            </div>
                            <div v-if="show_stock">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Codigo</th>
                                            <th>Descripción</th>
                                            <th>Cantidad en inventario</th>
                                            <th>Punto de pedido establecido</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr v-for="(s, index) in stock">
                                            <td class="text-left">{{s.code_product}}</td>
                                            <td class="text-left">{{s.description_product}}</td>
                                            <td>{{s.inventory_amount}}</td>
                                            <td>{{s.min_existence_limit}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <button class="btn btn-info btn-sm" @click="verMas()">
                                    <span class="material-icons">search</span> Ver más...
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="row text-center">
                        <div class="col" v-show="show_graph && !show_utilidad">
                            <select class="selectpicker" data-style="btn btn-info btn-sm" data-width="fit" name="filter_graph"
                                v-model="filter_graph" @change="filter" >
                                <option value=0  selected disabled  data-content="<i class='material-icons'>query_stats</i> Selecciona el tipo de busqueda:"></option>
                                <option value=1>Productos más vendidos</option>
                                <option value=2>Clientes con más ventas</option>
                                <option value=3>Proveedores con más compras</option>
                                <!-- <option value=5>Productos con mayor % de utilizad </option> -->
                                <option value=4>Productos en punto de pedido</option>
                            
                            </select>
                            <select v-if="company_scope_options.length > 1" class="selectpicker" data-style="btn btn-info btn-sm" data-width="fit"
                                    v-model="company_scope" @change="companyScopeChanged">
                                    <option v-for="opt in company_scope_options" :value="opt.value">{{opt.label}}</option>
                            </select>
                            <select  class="selectpicker" data-style="btn btn-primary btn-sm" data-width="fit" name="filter_graph"
                                    style=" width:50%!important;" @change="dateRange()" v-model="date_range" >
                                    <option value=0  selected disabled  data-content="<i class='material-icons' >date_range</i> Tiempo:"></option>
                                    <option value=7> Ultimos 7 dias</option>
                                    <option value=15>Ultimos 15 dias</option>
                                    <option value=30>Ultimos 30 dias</option>
                            </select>
                            <button  @click="changeGraph(1)" title="cambiar a grafico de barras"
                                class="btn btn-warning btn-sm"><i class="material-icons">bar_chart </i></button>
                            <button  @click="changeGraph(2)" title="ver grafico circular" class="btn btn-warning btn-sm"><i class="material-icons">donut_large</i></button>
                            <button v-show="filter_graph == 2" @click="goToClients()"  class="btn btn-warning btn-sm">Ver clientes con mas ventas</button>
                        </div>      
                    </div>
                </div>
            </div>
        </div>`
        ,
    methods: {
        getCompanyScopeParams: function () {
            if (this.company_scope === 'unified') {
                return { scope_mode: 'unified' };
            }
            if (this.company_scope && this.company_scope.indexOf('company:') === 0) {
                return {
                    scope_mode: 'company',
                    company_id: Number(this.company_scope.replace('company:', ''))
                };
            }
            return { scope_mode: 'company', company_id: idCompany };
        },
        loadCompanyScopeOptions: function () {
            if (window.graphScopeOptions && window.graphScopeOptions.length) {
                this.company_scope_options = window.graphScopeOptions;
                this.company_scope = window.graphScopeDefault || this.company_scope;
                this.$nextTick(function () {
                    $(".selectpicker").selectpicker('refresh');
                });
                return;
            }
            $.post(rootURL + 'app/modules/productos/bin/actions_graphics.php', {
                action: 'company_scope'
            }).then(d => {
                this.company_scope_options = d.options || [];
                if (d.default_value) {
                    this.company_scope = d.default_value;
                }
                this.$nextTick(function () {
                    $(".selectpicker").selectpicker('refresh');
                });
            });
        },
        companyScopeChanged: function () {
            if (this.show_stock) {
                this.showStock();
                return;
            }
            if (this.show_utilidad) {
                this.showUtilities();
                return;
            }
            if (this.show_product) {
                this.showProduct();
                return;
            }
            if (this.show_provider) {
                this.showProvider();
                return;
            }
            if (this.show_clientes) {
                this.showClientes();
                return;
            }
            this.filter();
        },
        showElements: function (element) {
            switch (element) {
                case 'product':
                    this.show_product = true;
                    this.show_provider = false;
                    this.show_clientes = false;
                    this.show_stock = false;
                    this.show_utilidad = false;
                    break;
                case 'provider':
                    this.show_product = false;
                    this.show_provider = true;
                    this.show_clientes = false;
                    this.show_stock = false;
                    this.show_utilidad = false;
                    break;
                case 'clientes':
                    this.show_product = false;
                    this.show_provider = false;
                    this.show_clientes = true;
                    this.show_stock = false;
                    this.show_utilidad = false;
                    break;
                case 'stock':
                    this.show_product = false;
                    this.show_provider = false;
                    this.show_clientes = false;
                    this.show_stock = true;
                    this.show_graph = false;
                    this.show_utilidad = false;
                    break;
                case 'utilities':
                    this.show_product = false;
                    this.show_provider = false;
                    this.show_clientes = false;
                    this.show_stock = false;
                    this.show_utilidad = true;
                    break;
            }
            this.$nextTick(function () {
                $(".selectpicker").selectpicker('refresh')
            });
        },
        dateRange: function () {
            if (this.show_product) {
                this.showProduct();
            } else if (this.show_provider) {
                this.showProvider();
            }
            else if (this.show_clientes) {
                this.showClientes();
            }
        },
        filter: function () {
            if (this.filter_graph == 1) {
                this.show_graph = true;
                this.showProduct();
            } else if (this.filter_graph == 2) {
                this.show_graph = true;
                this.showClientes();
            }
            else if (this.filter_graph == 3) {
                this.show_graph = true;
                this.showProvider();
            }
            else if (this.filter_graph == 4) {
                this.showStock();
            } else if (this.filter_graph == 5) {
                this.show_graph = true;
                this.showUtilities();
            }
        },
        filterMounted: function (i) {
            var action = i;
            $.post(rootURL + 'app/modules/productos/bin/actions_graphics.php', {
                action: action,
                date_range: this.date_range,
                ...this.getCompanyScopeParams(),
            }).then(d => {
                this.labels = [];
                this.data = [];
                this.fullLabels = []; // Guardar nombres completos
                var data = d;
                for (var i = 0; i < data.length; i++) {
                    this.labels.push(this.maxTitle(data[i].name));
                    this.fullLabels.push(data[i].name); // Nombre completo
                    this.data.push(data[i].quantity);
                }
                if (this.data.length == 0 && this.labels.length == 0) {

                    if (this.date_range == 0) {
                        this.date_range = 15;
                        this.filterMounted(action);
                    }
                    else if (this.date_range == 15) {
                        this.date_range = 30;
                        this.filterMounted(action);
                    }
                    else if (this.date_range == 30) {
                        this.date_range = 0;
                        if (action == 1) {
                            action = 2;
                            this.filterMounted(action);
                        }
                        else if (action == 2) {
                            action = 3
                            this.filterMounted(action);
                        }
                        else if (action == 3) {
                            this.filter_graph = 4;
                            this.showStock();
                        }
                    }
                } else {
                    this.filter_graph = action;
                    if (this.date_range == 0) {
                        this.date_range = 7;
                    }
                    var title = "";
                    if (action == 1) {
                        this.showElements('product');
                        title = 'Productos vendidos en los últimos  ';
                    } else if (action == 2) {
                        this.showElements('clientes');
                        title = 'Clientes con mayor monto en compras en los últimos ';
                    } else if (action == 3) {
                        this.showElements('provider');
                        title = 'Proveedores a los que más se compró en los últimos';
                    }
                    this.title = title + this.date_range + ' días';
                    this.createBarChart();
                    this.$nextTick(function () {
                        $(".selectpicker").selectpicker('refresh')
                    });
                }
            });

        },
        showProduct: function () {
            this.showElements('product');
            $.post(rootURL + 'app/modules/productos/bin/actions_graphics.php', {
                action: '1',
                date_range: this.date_range,
                ...this.getCompanyScopeParams(),
            }).then(d => {
                this.labels = [];
                this.data = [];
                this.fullLabels = []; // Guardar nombres completos
                var data = d;
                for (var i = 0; i < data.length; i++) {
                    this.labels.push(this.maxTitle(data[i].name));
                    this.fullLabels.push(data[i].name); // Nombre completo
                    this.data.push(data[i].quantity);
                }
                if (this.data.length == 0 && this.labels.length == 0) {
                    this.labels.push('No hay datos registrados, intente con otro rango de fechas');
                    this.data.push(0);
                }

                var range;
                if (this.date_range == 0) {
                    range = '7';
                } else {
                    range = this.date_range;
                }

                this.title = 'Productos vendidos en los últimos  ' + range + ' días';
                this.createBarChart();


            })

        },
        showProvider: function () {
            this.showElements('provider');
            $.post(rootURL + 'app/modules/productos/bin/actions_graphics.php', {
                action: '3',
                date_range: this.date_range,
                ...this.getCompanyScopeParams(),
            }).then(d => {
                this.labels = [];
                this.data = [];
                this.fullLabels = []; // Guardar nombres completos
                var data = d;
                for (var i = 0; i < data.length; i++) {
                    this.labels.push(this.maxTitle(data[i].name));
                    this.fullLabels.push(data[i].name); // Nombre completo
                    this.data.push(data[i].quantity);
                }
                if (this.data.length == 0 && this.labels.length == 0) {
                    this.labels.push('No hay datos registrados, intente con otro rango de fechas');
                    this.data.push(0);
                }
                var range;
                if (this.date_range == 0) {
                    range = '7';
                } else {
                    range = this.date_range;
                }
                this.title = 'Proveedores a los que más se compró en los últimos  ' + range + ' días';
                this.createBarChart();
            });
        },
        showClientes: function () {
            this.labels = [];
            this.data = [];
            this.showElements('clientes');
            $.post(rootURL + 'app/modules/productos/bin/actions_graphics.php', {
                action: '2',
                date_range: this.date_range,
                ...this.getCompanyScopeParams(),
            }).then(d => {
                this.labels = [];
                this.data = [];
                this.fullLabels = []; // Guardar nombres completos
                var data = d;
                for (var i = 0; i < data.length; i++) {
                    this.labels.push(this.maxTitle(data[i].name));
                    this.fullLabels.push(data[i].name); // Nombre completo
                    this.data.push(data[i].quantity);
                }
                var range;
                if (this.date_range == 0) {
                    range = '7';
                } else {
                    range = this.date_range;
                }
                this.title = 'Clientes con mayor monto en compras en los últimos' + range + ' días';
                this.createBarChart();
            })
        },
        showStock: function () {
            this.showElements('stock');
            $.post(rootURL + 'app/modules/productos/bin/actions_graphics.php', {
                action: 'stock',
                ...this.getCompanyScopeParams(),
            }).then(d => {
                this.show_table = true;
                this.stock = d;
            });
        },
        totalCost() {
            $.post(rootURL + 'app/modules/productos/bin/actions_graphics.php', {
                action: 'info',
                ...this.getCompanyScopeParams(),
            }).then(d => {
                this.inventory_sale = d.venta_total;
                this.inventory_cost = d.costo_total;
            });
        },
        showUtilities: function () {
            this.showElements('utilities');
            $.post(rootURL + 'app/modules/productos/bin/actions_graphics.php', {
                action: 'utilidad',
                ...this.getCompanyScopeParams(),
            }).then(d => {
                this.labels = [];
                this.data = [];
                this.fullLabels = []; // Guardar nombres completos
                var data = d;
                for (var i = 0; i < data.length; i++) {
                    this.labels.push(this.maxTitle(data[i].name));
                    this.fullLabels.push(data[i].name); // Nombre completo
                    this.data.push(data[i].y);
                }
                this.title = 'Productos con mayor utilidad % de utilidad';
                this.createBarChart();

            })
        },
        changeGraph(i) {
            if (i == '1') {
                this.type = 'bar';
            } else {
                this.type = 'doughnut';
            }
            //volver a cargar los datos que ya tiene el grafico
            this.createBarChart();
        },
        //funcion para crear el grafico
        createBarChart: function () {
            this.show_graph = true;
            var ctx = document.getElementById("myBarChart");
            if (this.myBarChart) {
                this.myBarChart.destroy();
            }
    
            var modernColors = [
                'rgba(100, 149, 237, 0.7)',
                'rgba(72, 149, 239, 0.7)',
                'rgba(90, 178, 162, 0.7)',
                'rgba(255, 179, 86, 0.7)',
                'rgba(240, 128, 128, 0.7)',
                'rgba(147, 112, 219, 0.7)',
                'rgba(221, 160, 221, 0.7)',
                'rgba(95, 158, 160, 0.7)',
                'rgba(244, 164, 96, 0.7)',
                'rgba(144, 238, 144, 0.7)'
            ];
            
            var modernBorders = [
                'rgba(100, 149, 237, 0.9)',
                'rgba(72, 149, 239, 0.9)',
                'rgba(90, 178, 162, 0.9)',
                'rgba(255, 179, 86, 0.9)',
                'rgba(240, 128, 128, 0.9)',
                'rgba(147, 112, 219, 0.9)',
                'rgba(221, 160, 221, 0.9)',
                'rgba(95, 158, 160, 0.9)',
                'rgba(244, 164, 96, 0.9)',
                'rgba(144, 238, 144, 0.9)'
            ];
            
            this.myBarChart = new Chart(ctx, {
                type: this.type,
                data: {
                    labels: Object.values(this.labels),
                    datasets: [{
                        label: this.title,
                        data: Object.values(this.data),
                        backgroundColor: modernColors,
                        borderColor: modernBorders,
                        borderWidth: 2,
                        borderRadius: this.type === 'bar' ? 8 : 0,
                        hoverBackgroundColor: modernColors.map(color => color.replace('0.85', '1')),
                        hoverBorderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: {
                                font: {
                                    size: 12,
                                    family: "'Roboto', 'Helvetica', 'Arial', sans-serif",
                                    weight: '500'
                                },
                                padding: 10,
                                usePointStyle: true,
                                pointStyle: 'circle',
                                boxWidth: 8,
                                boxHeight: 8
                            }
                        },
                        tooltip: {
                            enabled: true,
                            backgroundColor: 'rgba(0, 0, 0, 0.9)',
                            titleFont: {
                                size: 14,
                                weight: 'bold'
                            },
                            bodyFont: {
                                size: 13
                            },
                            padding: 15,
                            cornerRadius: 8,
                            displayColors: true,
                            callbacks: {
                                title: (context) => {
                                    // Mostrar el nombre completo en el título del tooltip
                                    const index = context[0].dataIndex;
                                    return this.fullLabels && this.fullLabels[index] ? this.fullLabels[index] : context[0].label;
                                },
                                label: function(context) {
                                    let label = 'Cantidad: ';
                                    label += context.parsed.y || context.parsed;
                                    return label;
                                }
                            }
                        }
                    },
                    scales: this.type === 'bar' ? {
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                font: {
                                    size: 10,
                                    family: "'Roboto', 'Helvetica', 'Arial', sans-serif"
                                },
                                maxRotation: 0,
                                minRotation: 0,
                                autoSkip: false,
                                maxTicksLimit: 20,
                                callback: function(value, index) {
                                    const label = this.getLabelForValue(value);
                                    // Dividir el texto en 2 líneas
                                    const maxCharsPerLine = 22;
                                    
                                    if (label.length <= maxCharsPerLine) {
                                        return label;
                                    }
                                    
                                    // Buscar un espacio para dividir naturalmente
                                    let breakPoint = label.lastIndexOf(' ', maxCharsPerLine);
                                    
                                    if (breakPoint === -1 || breakPoint < maxCharsPerLine / 2) {
                                        // Si no hay espacio o está muy al inicio, cortar directamente
                                        breakPoint = maxCharsPerLine;
                                    }
                                    
                                    const line1 = label.substring(0, breakPoint).trim();
                                    const line2 = label.substring(breakPoint).trim();
                                    
                                    // Si la segunda línea es muy larga, truncarla
                                    if (line2.length > maxCharsPerLine) {
                                        return [line1, line2.substring(0, maxCharsPerLine - 2) + '...'];
                                    }
                                    
                                    return [line1, line2];
                                }
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)',
                                drawBorder: false
                            },
                            ticks: {
                                font: {
                                    size: 12,
                                    family: "'Roboto', 'Helvetica', 'Arial', sans-serif"
                                },
                                padding: 10
                            }
                        }
                    } : {},
                    animation: {
                        duration: 1000,
                        easing: 'easeInOutQuart'
                    },
                    interaction: {
                        mode: 'index',
                        intersect: false
                    }
                }
            });
        },
        verMas: function () {
            window.location.replace(rootURL + "app/modules/productos/index.php?tt=adm-pro&limit_exist=1");
        },
        maxTitle: function (text) {
            if (text.length > 35) {
                return text.substring(0, 25) + '...';
            } else {
                return text;
            }
        },
        getFullTitle: function(text) {
            return text;
        },
        goToClients: function () {
            window.location.replace(rootURL + "app/modules/clientes/index.php?tt=adm&showVentas=1");
        },
        handleResize: function() {
            if (this.myBarChart && this.show_graph) {
                this.createBarChart();
            }
        }
    },
    mounted: function () {
        let self = this;
        this.loadCompanyScopeOptions();
        setTimeout(function(){
            self.filterMounted(1);
        }, 200);
        
        // Agregar listener para resize
        let resizeTimeout;
        this.resizeListener = function() {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(function() {
                self.handleResize();
            }, 250);
        };
        window.addEventListener('resize', this.resizeListener);
    },
    beforeDestroy: function() {
        if (this.resizeListener) {
            window.removeEventListener('resize', this.resizeListener);
        }
        if (this.myBarChart) {
            this.myBarChart.destroy();
        }
    }
}

