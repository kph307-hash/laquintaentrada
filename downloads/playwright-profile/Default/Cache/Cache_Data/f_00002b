  async function getLocalPrinters() {
    const storagePath = `${uuidCompany}_printerChannels`;
    //tratar de cargar por el storage
    var localPrinters = localStorage.getItem(storagePath);
    let inLocalStorage = true;

    if (!localPrinters) {
      //tratar de cargar con el archivo json de navedi
      console.log("searching from navedi");
      inLocalStorage = false;
      localPrinters = await init_navedi()
        .then(async () => {
          return await navedi.file.read(storagePath + ".json").catch((e) => null);
        })
        .catch(() => null);
    }

    if (localPrinters) {
      localPrinters = JSON.parse(localPrinters);
    } else {
      localPrinters = {};
    }

    if (!inLocalStorage) {
      localStorage.setItem(storagePath, JSON.stringify(localPrinters));
    }

    return localPrinters;
  }

  async function init_navedi() {
    /// Authentication setup ///
    if (navedi_connected === false) {
      navedi.security.setCertificatePromise(function (resolve, reject) {
        $.ajax({
          url: rootURL + "app/assets/signing/navedi-4108-fullchain.cert.pem",
          cache: false,
          dataType: "text",
        }).then(resolve, reject);
      });
      navedi.security.setSignatureAlgorithm("SHA512");
      navedi.security.setSignaturePromise(function (toSign) {
        return function (resolve, reject) {
          try {
            var pk = KEYUTIL.getKey(npk);
            var sig = new KJUR.crypto.Signature({
              alg: "SHA512withRSA",
            });
            sig.init(pk);
            sig.updateString(toSign);
            var hex = sig.sign();
            resolve(stob64(hextorstr(hex)));
          } catch (err) {
            console.error(err);
            reject(err);
          }
        };
      });
      //Conectarse a Navedi
      navedi.websocket.setClosedCallbacks(() => {
        navedi_connected = false;
        console.log("Desconectado de Navedi");
      });
      return navedi.websocket
        .connect()
        .then(async () => {
          navedi_connected = true;
          console.log("Conectado a Navedi");
          if (typeof vAppRest != "undefined") {
            vAppRest.hasNavedi = true;
          }
        })
        .catch((e) => {
          navedi_connected = false;
          if (typeof vAppRest != "undefined") {
            vAppRest.hasNavedi = "error";
          }
          throw e;
        });
    } else {
      return new Promise((resolve) => resolve());
    }
  }

