  async function loadClientModal(action, id = 0, tab = "", moduleName = "", callbacks = {}) {
    // Detectar versión de Vue
    const isVue3 = typeof VUE_VERSION !== "undefined" && VUE_VERSION == 3;

    if (isVue3) {
      // Para Vue 3: usar el componente modular
      // Si el componente ya está inicializado
      if (typeof vModalCliente === "object" && vModalCliente.open) {
        vModalCliente.open(action, id, tab, moduleName, callbacks);
        return;
      }

      // Si no está inicializado, cargar dinámicamente
      modalCargando();
      try {
        await import(rootURL + "app/js/components/init-modal-cliente.js?v=1.0.10");

        // Esperar un momento para que se monte el componente
        await new Promise((resolve) => setTimeout(resolve, 100));

        if (typeof vModalCliente === "object" && vModalCliente.open) {
          vModalCliente.open(action, id, tab, moduleName, callbacks);
        } else {
          throw new Error("No se pudo inicializar el modal de cliente");
        }
      } catch (err) {
        console.error("Error cargando componente Vue 3 de modal cliente:", err);
        $.notify("Error al cargar el modal de cliente", { type: "danger" });
      } finally {
        modalCargando(false);
      }
      return;
    }

    // Para Vue 2: mantener el sistema existente
    modalCargando();
    let apiPath = "/app/modules";
    if (window.location.pathname == "/admin/") {
      moduleName = "admin";
      apiPath = "/admin";
    } else if (moduleName == "") {
      const regex = /modules\/([\w]*)\//gm;
      let m;
      while ((m = regex.exec(window.location.pathname)) !== null) {
        // This is necessary to avoid infinite loops with zero-width matches
        if (m.index === regex.lastIndex) {
          regex.lastIndex++;
        }
        if (m[1]) moduleName = m[1].replace(/_/g, "-");
      }
    }
    const form = new FormData();
    form.append("action", action);
    form.append("module", moduleName);
    form.append("id", id);
    form.append("html", true);
    form.append("tab", tab);
    if (moduleName == "centro-cobros") {
      apiPath = "/app/modules/centro_cobros";
    }

    await fetch(serverURL + apiPath + "/clientes/modal.php", {
      method: "POST",
      body: form,
    })
      .then((r) => r.json())
      .then((r) => {
        modalCargando(false);
        if (r.error) {
          throw new Error(r.error.msg);
        }
        $("body").append(r.html);
      })
      .catch((e) => {
        modalCargando(false);
        console.error(e);
        $.notify(e, {
          type: "danger",
        });
      });
  }

