  }

  if ($("#cl-modal").length) {
    $("#cl-modal").modal("hide");
    abrirModal = "#cl-modal";
  }

  const email = await app.select_email(emails, false);
  if (!email) {
    if (abrirModal) {
      $(abrirModal).modal("show");
    }
    $.notify("No se seleccionó ningún correo electrónico", {
      type: "warning",
    });
