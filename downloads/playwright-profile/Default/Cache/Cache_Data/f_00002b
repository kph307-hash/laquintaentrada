      async function doPrint(data, pchannel, ignorePrinted = false, callback = null) {
        //esperar a que termine la impresion para continuar
        await waitForPrinting();
        //variable para verificar si la impresion se dio o no
        let printed = false;

        if (!ignorePrinted) {
          //verificar si ya fue impreso
          let printedDocuments = await getPrintedDocuments();
          if (printedDocuments.length > 0) {
            //ya hay documentos impresos, verificar si ya se imprimio el documento
            let printedDocument = printedDocuments.some((doc) => data.id_queue == doc);

            //ya es un documento que fue impreso
            if (printedDocument) {
              return;
            }
          }
        }

        let id_channel = this.id_channel ? this.id_channel : pchannel;
        let navediPrinter = "";
        try {
          //variable para indicar que esta en proceso de impresion
          printing = true;

          //inicializar navedi
          await init_navedi();

          //tomar informacion del canal
          let channel = channels.find((c) => c.id == id_channel);

          //verificar si se encuentra la impresora
          navediPrinter = await navedi.printers.find(channel.printer.name).catch((err) => {
            return false;
          });
          if (navediPrinter) {
            let print_text;

            //traer datos de impresion
            let print_data = await requestQueue(data.id_queue);

            //mandar a su respectiva funcion dependiendo del tipo
            switch (channel.type) {
              case 1:
                print_text = await printCommand(print_data.data, channel);
                break;
              case 2:
                print_text = await printPreBill(print_data.data, channel);
                break;
              case 3:
                print_text = await printBill(print_data.data, channel);
                break;
              case 4:
                print_text = await printPurchaseOrder(print_data.data, channel);
                break;
            }

            //si devolvio un texto correcto, imprimir
            if (print_text) {
              var config = navedi.configs.create(navediPrinter);
              let prints = [navedi.print(config, print_text)];
              if (channel.print_twice) {
                prints.push(navedi.print(config, print_text));
              }
              await Promise.all(prints)
                .then(() => {
                  printed = true;
                })
                .catch(function (e) {
                  console.error(e);
                });
            } else {
              throw new Error("Error al obtener plantilla de impresión");
            }
            if (callback) {
              callback(true);
            }
          }
        } catch (error) {
          console.error(error);
          if (callback) {
            callback(false);
          }
          const bc = getBroadcastChannel();
          bc.postMessage({ error: error.message });
        } finally {
          printing = false;
          if (printed) {
            await savePrinted(data.id_queue, navediPrinter);
          }
        }
      }
