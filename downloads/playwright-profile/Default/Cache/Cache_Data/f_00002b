  function modalScanner(modalOpenAfterClose = "", source) {
    swal.close();
    if (typeof Android == "object") {
      //llamar al metodo de la app android
      Android.requestBarcodeScan();
    } else {
      // mediante navegador
      if ($("#scanner_modal").length == 0) {
        $("body").append(`<div id="scanner_modal" ></div>`);
        $("#scanner_modal").load(rootURL + "app/modals/modal_scanner.php", function () {
