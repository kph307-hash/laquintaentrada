  async function syncDb(db, tables, forceUpdate = false, updateFreq = 5, extraData = null, forceAll = false) {
    // Detectar si estamos en el área de admin
    const isAdmin = window.location.pathname.includes("/admin/");
    const url = isAdmin ? "/admin/ajax/syncPull.php" : "/app/ajax/syncPull.php";
    let queries = [];
    let showProgress = false;
    try {
      for (const table of tables) {
        await db.updates
          .where("tbName")
          .equals(table)
          .first()
          .then((row) => {
            let last_updated = null;
            let doQuery = true;
            if (row) {
              last_updated = moment(row.last_update, "YYYY-MM-DD H:mm:ss");
              if (forceUpdate === false) {
                // Solo refrescar datos si son mas viejos que la frecuencia solicitada
                doQuery = moment().subtract(updateFreq, "m") > last_updated;
              }
              if (table === "locations" || table === "activities") doQuery = false;
            }
            if (doQuery) {
              queries.push(table + (last_updated && !forceAll ? last_updated.format("YYYYMMDDHHmmss") : ""));
            }
            showProgress |= last_updated === null;
          });
      }
      if (queries.length == 0) {
        return [];
      }
      const query = queries.reduce((q, v) => q + "," + v, "").substring(1);
      let resolveFinished;
      let rejectFinished;
      const finished = new Promise((r, b) => {
        resolveFinished = r;
        rejectFinished = b;
      });
      const updates = [];
      if (showProgress) {
        swal({
          title: `<span id="sync-title">Cargando datos...</span>`,
          allowOutsideClick: false,
          allowEscapeKey: false,
          showConfirmButton: false,
          animation: false,
          html: `
          <div class="text-center">
              <p id="sync-text"></p>
          </div>
          <div class="progress progress-line-primary">
              <div id="exporter-percent-bar" class="progress-bar" role="progressbar" style="width: 0%;">
                  <span class="sr-only">0%</span>
              </div>
          </div>
          <div class="text-center">
              <p id="exporter-percent-value">0%</p>
          </div>`,
        });
      }
      const sse = new EventSource(
        url +
          "?" +
          $.param({
            tables: query,
            extraData: extraData ? JSON.stringify(extraData) : null,
          }),
      );

      let total_request = 0;
      let table_total = 0;
      let progress;
      const names = {
        activities: "Actividades",
        categories: "Categorias",
        clients: "Clientes",
        exemptions: "Exoneraciones",
        inventories: "Inventario",
        products: "Productos",
        settings: "Configuracion",
        suppliers: "Proveedores",
        taxes: "Impuestos",
        templates: "Plantillas",
        users: "Usuarios",
        warehouses: "Bodegas",
        custom_prices_for_products: "Precios personalizados",
        purchase_product: "Productos alistado en compra",
        composite_products: "Productos compuestos",
        bill_history: "Historial de facturas",
        repair_module: "Info de reparaciones",
        product_promotions: "Productos en promociones",
        promotions: "Promociones",
        categories_on_clients: "Categorias en clientes",
        maintenance_service_categories: "Categorias de servicios de mantenimiento",
        cl_activities: "Actividades de clientes",
      };

      sse.onmessage = (m) => {
        const result = JSON.parse(m.data);
        const table = result?.table;
        switch (m.lastEventId) {
          case "UPDATE":
            if (!table) break;
            updates.push(["update", table, result.entries]);
            if (showProgress) {
              $("#sync-text").text(names[table]);
              table_total += result.entries.length;
              progress = ((table_total / total_request) * 100).toFixed(0);
              $("#exporter-percent-bar").css("width", progress + "%");
              $("#exporter-percent-value").text(progress + "%");
            }
            break;

          case "DELETE":
            if (!table) break;
            if (showProgress) {
              $("#sync-text").text(table);
            }
            const deletions = [];
            for (var i in result.entries) {
              const r = result.entries[i];
              deletions.push("id" in r ? r.id : r);
            }
            updates.push(["delete", table, deletions]);
            break;

          case "SYNCED":
            if (!table) break;
            updates.push(["synced", table]);
            break;

          case "COUNT":
            if (!showProgress) break;
            total_request = result.qty;
            table_total = 0;
            $("#exporter-percent-bar").css("width", 0 + "%");
            $("#exporter-percent-value").text(0 + "%");
            break;

          case "CLOSE":
            resolveFinished(result.time);
            break;

          case "DEBUG":
            console.log(result.val);
            break;

          case "PING":
            console.log("PING");
            break;

          case "JWT":
            setJWT(result.jwt);
            break;

          case "ERROR":
            sse.close();
            const err = "Los datos de la empresa no se pudieron cargar. " + result.error;
            if (showProgress) {
              swal.close();
              swal("Ocurrió un error", err, "error");
            }
            throw new Error(err);

          default:
            break;
        }
      };

      sse.onerror = (e) => {
        console.error(e);
        sse.close();
        if (showProgress) {
          swal.close();
          swal("Ocurrió un error", "Los datos de la empresa no se pudieron cargar. Por favor recargue la página.", "error");
        }
        rejectFinished("Rejected on SSE Error");
      };

      const done = await finished.then(async (time) => {
        if (showProgress && sse.readyState !== 2) {
          swal.close();
        }
        sse.close();
        const toUpdate = Array.from(new Set(updates.map((u) => (u[0] !== "synced" ? u[1] : null)).filter((u) => u !== null)));
        const tables = Array.from(new Set(updates.map((u) => u[1])));
        toUpdate.push("updates");
        await db.transaction("rw", toUpdate, async () => {
          for (const job of updates) {
            if (job[0] === "update") {
              if (job[1] === "barcodes") {
                let newEntries = job[2];
                const seenEntries = {};
                const duplicates = [];
                newEntries.forEach((entry) => {
                  const uniqueKey = `${entry.idp}-${entry.barcode}`;
                  if (seenEntries[uniqueKey]) {
                    // Si la combinación ya fue vista, lo consideramos un duplicado
                    duplicates.push(entry);
                  } else {
                    // Si no ha sido vista, la agregamos al objeto seenEntries
                    seenEntries[uniqueKey] = true;
                  }
                });
                //eliminar duplicados
                newEntries = newEntries.filter((entry) => {
                  const uniqueKey = `${entry.idp}-${entry.barcode}`;
                  return seenEntries[uniqueKey] && !duplicates.some((dup) => `${dup.idp}-${dup.barcode}` === uniqueKey);
                });
                await db[job[1]].bulkPut(newEntries);
                await Promise.resolve(updIndex("UPDATE", job[1], newEntries));
              } else if (job[1] === "activities") {
                let newEntries = job[2];

                try {
                  // Filtrar duplicados en los nuevos datos primero
                  const uniqueMap = new Map();
                  newEntries.forEach((entry) => {
                    if (!entry.cdg) return; // Ignorar entradas sin código

                    if (!uniqueMap.has(entry.cdg) || entry.id > uniqueMap.get(entry.cdg).id) {
                      uniqueMap.set(entry.cdg, entry);
                    }
                  });
                  newEntries = Array.from(uniqueMap.values());

                  if (newEntries.length === 0) {
                    console.log("No hay actividades válidas para sincronizar");
                    await Promise.resolve(updIndex("UPDATE", job[1], []));
                    continue;
                  }

                  let successCount = 0;
                  let errorCount = 0;

                  for (const activity of newEntries) {
                    try {
                      await db.activities.put(activity);
                      successCount++;
                    } catch (err) {
                      if (err.name === "ConstraintError") {
                        // Error de restricción - probablemente duplicado, intentar update
                        try {
                          const existing = await db.activities.where("cdg").equals(activity.cdg).first();
                          if (existing && activity.id > existing.id) {
                            // Solo actualizar si el nuevo es más reciente
                            await db.activities.update(existing.id, activity);
                            successCount++;
                          }
                        } catch (updateErr) {
                          console.warn(`No se pudo sincronizar actividad ${activity.cdg}:`, updateErr.message);
                          errorCount++;
                        }
                      } else {
                        console.warn(`Error sincronizando actividad ${activity.cdg}:`, err.message);
                        errorCount++;
                      }
                    }
                  }

                  await Promise.resolve(updIndex("UPDATE", job[1], newEntries));
                } catch (error) {
                  console.error("Error general en sincronización de activities:", error);
                  // Continuar con las demás tablas aunque activities falle
                  await Promise.resolve(updIndex("UPDATE", job[1], []));
                }
              } else {
                await db[job[1]].bulkPut(job[2]);
                await Promise.resolve(updIndex("UPDATE", job[1], job[2]));
              }
            } else if (job[0] === "delete") {
              await db[job[1]].bulkDelete(job[2]);
              await Promise.resolve(updIndex("DELETE", job[1], job[2]));
            }
          }
          const entries = tables.map((t) => {
            return { tbName: t, last_update: time };
          });
          await db.updates.bulkPut(entries);
        });
        return tables;
      });
      return done;
    } catch (e) {
      console.error(e);
      sendAudit(e.message, "syncDb");
      throw e;
    }
  }

