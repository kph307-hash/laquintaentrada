async function _verifyUserPermissions() {
  if (!idUser) return;
  const alertPerms = () => {
    swal({
      title: "Se cambiaron los permisos",
      type: "error",
      text: "Se ha detectado un cambio en los permisos de tu usuario, por favor recargar la página",
      confirmButtonText: "Recargar",
      confirmButtonClass: "btn btn-primary",
      buttonsStyling: false,
      allowOutsideClick: false,
      allowEscapeKey: false,
    })
      .then(() => {
        location.reload();
      })
      .catch(swal.noop);
  };

  await app.initializeDatabase(["users"]);
  const user = await app.getDb().users.where("id").equals(idUser).first();
  const cooldown = 120000; //cada 2 minutos
  let verifyPerms = () => {
    app.syncTables(["users"]).then(async (tables) => {
      if (tables.length > 0) {
        //volver a consultar los permisos a ver si cambiaron
        let updatedUser = await app.getDb().users.where("id").equals(idUser).first();
        let actualPermissions = user.permissions;
        let updatedPermissions = updatedUser.permissions;

        if (user.warehouse != updatedUser.warehouse || user.is_admin != updatedUser.is_admin) {
          alertPerms();
        }
        //verificar permiso por permiso si cambió
        for (let key in actualPermissions) {
          if (actualPermissions[key] != updatedPermissions[key]) {
            alertPerms();
            break;
          }
        }
      }
      setTimeout(verifyPerms, cooldown);
    });
  };
  setTimeout(verifyPerms, cooldown);
}

