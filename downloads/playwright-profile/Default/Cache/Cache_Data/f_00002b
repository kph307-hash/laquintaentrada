      engine.registerFilter("wordWrap", (s, w = 75, b = "\\n", c = false) => {
        if (!s) {
          return s;
        }
        b = b.replace("x0A", "\\n");
        const regex = `.{1,${w}}(\\s|$)` + (c ? `|.{${w}}|.+$` : "|\\S+?(\\s|$)");
        const m = s.match(RegExp(regex, "g"));
        const l = [];
        m.forEach((s) => l.push(s.trim()));
        return l.join(b);
      });
      engine.registerFilter("qrcode", (v, t = "svg") => {
        if (t == "svg") {
          return QRCode({ msg: v, pad: 0 }).outerHTML; //devolver imagen SVG con el codigo qr
        } else if (t == "escpos") {
          const ec = 2;
          const size = 5;
          const model = 3;
          const sendCodeData = (fn, data) => {
            const len = data.length + 2;
            const l = String.fromCharCode(len % 256);
            const h = String.fromCharCode(Math.floor(len / 256));
            return "\x1d(k" + l + h + "1" + fn + data;
          };
          let qr = sendCodeData("A", String(model) + "\x00");
          qr += sendCodeData("C", String.fromCharCode(size));
          qr += sendCodeData("E", String(ec));
          qr += sendCodeData("P", "0" + v);
          qr += sendCodeData("Q", "0");
          let code = "";
          for (let i = 0; i < qr.length; i++) {
            const cp = qr.codePointAt(i);
            if (cp < 33) {
              code += "\\x" + cp.toString(16).padStart(2, "0");
            } else {
              code += qr.charAt(i);
            }
          }
          return code;
        } else {
          return "";
        }
      });
      //si la empresa es 3177, guardamos la info en localstorage para darle seguimienot a la factura
      if (idCompany == 3177 && datos.condicion == "APARTADO") {
        let factura = JSON.parse(localStorage.getItem("facturas_seguimiento_ticket_20345"));
        factura = factura ? factura : [];
        factura.push(datos);
        localStorage.setItem("facturas_seguimiento_ticket_20345", JSON.stringify(factura));
      }
      if (navigator.userAgent.indexOf("Android") > 1) {
        await db.templates
          .where("id")
          .equals(999)
          .toArray(async (a) => {
            if (a.length) {
              const t = a[0].template;
              datos.movil = await engine.parseAndRender(t, datos).then((h) => h);
            }
          });
      }
      const html = await engine
        .parseAndRender(template, datos)
        .then((h) => h)
        .catch((e) => {
          console.error(e);
          throw e;
        });
      return html;
    } catch (e) {
      console.error("error al facturar", e);
      throw e;
    }
  }

  /**
   * @param {Object} d datos de la comanda, con el mismo formato que devuelve la clase Comanda de php
   * @param {string} template html de la plantilla a usar
   *
   * @returns {Promise<string>} html de la factura
   */
  async function imprimirComanda(d, template) {
    const datos = {
      ...d,
      hasExpress: d.client_name || d.client_address || d.client_cellphone,
    };

    for (let key in datos) {
      let dato = datos[key];
      if (typeof dato === "string") {
        datos[key] = dato != "" ? dato : null;
      }
    }
    const engine = new liquidjs.Liquid();
    engine.registerFilter("wordWrap", (s, w = 75, b = "\\n", c = false) => {
      if (!s) {
        return s;
      }
      const regex = `.{1,${w}}(\\s|$)` + (c ? `|.{${w}}|.+$` : "|\\S+?(\\s|$)");
      const m = s.match(RegExp(regex, "g"));
      const l = [];
      m.forEach((s) => l.push(s.trim()));
      const f = l.join(b.replace("x0A", "\\n"));
      return f;
    });
    const html = await engine.parseAndRender(template, datos).then((h) => h);
    return html;
  }
  /**
     *
     * @param {*} type  el tipo de peticion, admin = necesita una clave asignada por un admin para poder llevar a acabo una accion, user = clave propia del usuario, restaurant = para desbloquear la pantalla en el modulo de restaurantes a partir de la clave de 4 digitos asignada por el usuario
     * @param {*} prompt El texto que se mostrara al inicio de la alerta en un H5
     * @param {Number} action el tipo de accion a llevar a cabo:
     *      0 = general ||
            1 = editar producto ||
            2 = nota credito ||
            3 = devoluciones ||
            4 = movimientos en inventario ||
            5 = facturar sin inventario ||
            6 = exceder descuento maximo en un producto ||
