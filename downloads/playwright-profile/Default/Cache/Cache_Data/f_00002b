  async function getSearchIndex(table) {
    if (fsIndexes[table]) {
      return fsIndexes[table];
    } else {
      var index;
      if (table == "clients") {
        index = new FlexSearch.Document({
          tokenize: "forward",
          document: {
            id: "id",
            index: [
              { field: "cdg", tokenize: "full" },
              { field: "bus", tokenize: "forward" },
              { field: "nm", tokenize: "forward" },
              { field: "gid", tokenize: "forward" },
              { field: "tel", tokenize: "forward" },
              { field: "cel", tokenize: "forward" },
            ],
          },
        });
      } else if (table == "products") {
        index = new FlexSearch.Document({
          resolution: 9,
          cache: 100,
          worker: true,
          encoder: "simple",
          document: {
            id: "id",
            index: [
              {
                field: "cdg",
                tokenize: "full",
              },
              {
                field: "dsc",
                tokenize: "full",
              },
            ],
          },
        });
      } else if (table == "suppliers") {
        index = new FlexSearch.Document({
          tokenize: "forward",
          document: {
            id: "id",
            index: ["cdg", "nm", "gid"],
          },
        });
      } else if (table == "users") {
        index = new FlexSearch.Document({
          tokenize: "forward",
          document: {
            id: "id",
            index: ["name", "uid"],
          },
        });
      } else {
        return false;
      }

      if (debugMode) {
        performance.mark("create-index-" + table);
      }
      await app.getDb()[table].toArray((d) => {
        console.log("Adding " + d.length + " to " + table + " index");
        d.forEach(async (doc) => {
          await index.addAsync(doc.id, doc);
        });
      });
      if (debugMode) {
        performance.mark("created-index-" + table);
        performance.measure("time-" + table, "create-index-" + table, "created-index-" + table);
        const pMeasure = performance.getEntriesByName("time-" + table)[0];
        console.log(`${pMeasure.name}: ${pMeasure.duration}`);
      }

      fsIndexes[table] = index;
      return index;
    }
  }

  function excelClass(headers) {
    return new (class Excel {
      //estilos para la linea de totales
      static styleTotal = {
        backgroundColor: "808080",
        fontColor: "FFFFFF",
        fontBold: true,
      };
      constructor(headers = []) {
        this.headers = headers;
        this.rows = [];
      }

      //agregar filas al Excel
      addRow(row, style) {
        let rowValue = [];
        let rowStyle = [];

        const filterStyles = (styles) => {
          const acceptedStyles = ["backgroundColor", "fontColor", "fontBold", "cellAlignment", "fontSize"];
          var values = {};
          for (var d in styles) {
            if (acceptedStyles.includes(d)) {
              values[d] = styles[d];
            } else {
              console.error(`El estilo ${d} no es aceptado`);
            }
          }
          return values;
        };

        for (var cell of row) {
          var cellValue = null;
          var cellStyle = [];
          if (typeof cell === "object" && cell !== null) {
            //es un objeto
            if (typeof cell.value != "undefined") {
              cellValue = cell.value;
            } else {
              throw "row.value es requerido";
            }

            if (cell.style) {
              cellStyle = filterStyles(cell.style);
            }
            if (cellValue !== null && cellStyle) {
              rowValue.push({
                value: cellValue,
                style: cellStyle,
              });
            } else if (cellValue !== null) {
              //solo vienen el data, sin estilo, asi que lo agregamos como un array normal
              rowValue.push(cellValue);
            }
          } else {
            //es solo un array, le hacemos push
            rowValue.push(cell);
          }
        }
        // console.log(style)
        rowStyle = filterStyles(style);

        if (rowValue && rowValue.length > 0) {
          var data_to_push = {
            value: rowValue,
          };

          if (rowStyle && Object.values(rowStyle).length > 0) {
            data_to_push.style = rowStyle;
          }
          this.rows.push(data_to_push);
        }
      }

      getFormatedData() {
        const data = {
          headers: this.headers,
          rows: this.rows,
        };
        return data;
      }

      //exportar a excel
      exportToExcel(name) {
        const data = this.getFormatedData();
        swal({
          title: "Generando Excel...",
          allowOutsideClick: false,
          allowEscapeKey: false,
          showConfirmButton: false,
        });
        const form = new FormData();
        form.append(
          "request",
          JSON.stringify({
            headers: data.headers,
            title: name,
            data: data.rows,
          }),
        );
        fetch(serverURL + "/app/ajax/excel.php", {
          method: "POST",
          body: form,
        })
          .then((res) => {
            if (!res.ok) {
              throw Error(res.statusText);
            } else {
              return res.json();
            }
          })
          .then((res) => {
            swal.close();
            window.location.assign(res.message);
          })
          .catch((err) => {
            swal.close();
            swal("Ocurrió un error", "No se pudo generar el reporte en Excel", "error");
          });
      }
    })(headers);
  }

