let androidMessagePort = undefined;
let androidAppVersion = "";
window.addEventListener("message", function (event) {
  const allowedOrigin = "android-app://" + new URL(serverURL).host;
  if (!event.origin.startsWith(allowedOrigin)) return;

  // get the port then use it for communication.
  androidMessagePort = event.ports[0];
  if (typeof androidMessagePort === "undefined") return;

  // Receive upcoming messages on this port.
  androidMessagePort.onmessage = function (event) {
    if (!androidAppVersion) {
      // El primer mensaje es la version
      androidAppVersion = event.data;
      return;
    }
    console.log("[PostMessage] Got message: " + event.data);
  };
});

function sendMessageToAndroidApp(message) {
  if (typeof androidMessagePort !== "undefined") {
    androidMessagePort.postMessage(message);
    return true;
  } else {
    return false;
  }
}
