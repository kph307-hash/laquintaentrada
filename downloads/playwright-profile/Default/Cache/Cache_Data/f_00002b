   * @param {String} scannedText  El resultado del scanner proveniento del metodo scanCode a la app Android.
   */
  function callFromScanAndroid(scannedText) {
    if (!scannedText || scannedText == "" || scannedText == "null" || scannedText == "undefined") {
      showNotification("danger", "No se pudo leer el código de barras");
      return;
    }
    //si el texto escaneado no es un numero, entonces no es un codigo de barras
    if (isNaN(scannedText)) {
      showNotification("danger", "El código de barras no es válido");
      return;
    }
    //obtener la url actual
    var url = window.location.href;
    //si estamos en la pagina de productos
    if (url.indexOf("productos") > -1 && typeof vApp !== "undefined" && !$("#vProd").hasClass("in")) {
      vApp.product = scannedText;
      vApp.loadProducts();
    } else if (typeof vProd !== "undefined" && $("#vProd").hasClass("in")) {
      vProd.setBarcode(scannedText);
    } else if (typeof vApp !== "undefined") {
      //si estamos en punto de venta
      vApp.product = scannedText;
      vApp.addFactura(0, null, null, 0, 0, true);
    }
  }

