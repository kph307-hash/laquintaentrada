      form2.append("html", htmlContent);
    }
    form2.append("email", email);
    let res = await fetch(serverURL + "/app/ajax/sendHtmlToMail.php", {
      body: form2,
      method: "POST",
    });
    if (!res.ok) {
      throw "Error de servidor";
