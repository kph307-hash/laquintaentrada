  function requestAuth(type, prompt, action = 0, id_affected = 0, idCompany = 0, codigo = 0, html = "") {
    /*
      Action:
      0 = general,
      1 = editar producto,
      2 = nota credito,
      3 = devoluciones,
      4 = movimientos en inventario,
      5 = facturar sin inventario,
      6 = exceder descuento maximo en un producto,
      7 = eliminar documentos pendientes en punto de ventas,
      8 = exceder el credito,
      9 = elimnar documentos en reporte de ventas,
      10 = crear un producto en punto de venta,
      11 = utilizar comodin,
      12 = modifica un producto,
      13 = crear un producto,
      14 = crear compra en recepcion,
      15 = crear un gasto en recepcion,
      16 = crear un producto en productos y servicios,
      17 = modifica un producto en punto de venta,
      18 = limpiar productos en Punto de venta
      19 = remover productos de una proforma
      20 = retirar dinero de la caja
      98 = Solicitud de acceso a la empresa
      99 =  contrasena de desbloqueo en restaurante
    */

    //hacemos la solicitud de autorizacion
    new Promise((resolve, reject) => {
      fetch(rootURL + "app/ajax/authenticate.php", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          type,
          idCompany,
          userid: idUser,
          action,
          tokenRequest: 0,
          id_affected,
          codigo,
        }),
      })
        .then((res) => res.json())
        .then((res) => {
          resolve(res.data);
        })
        .catch((err) => {
          reject(err);
        });
    });
    const ph = type === "admin" ? "Clave de acceso" : type === "restaurant" ? "PIN" : "Contraseña de usuario";
    const affected = action == 2 ? "Numero de documento afectado " + " #" + codigo : action == 1 ? "Codigo de producto afectado " + codigo : "";
    const maxLength = type == "restaurant" ? 4 : 50;
    return swal({
      text: prompt,
      html: `
        <h5 class="text-center">${prompt}</h5>
        <form action="javascript:void(0);" autocomplete="off">
          <div class="form-group" style='display:flex; align-items:center;'>
            <input maxlength="${maxLength}" type="password" id="swal-password" class="swal2-input" autocomplete="new-password"   onfocus="this.removeAttribute('readonly');"
            >
            <button type="button" class="btn btn-info btn-just-icon" id='toggle-pass-visibility'><i class='material-icons' id ='pass-visibility-icon'>visibility</i></button>
          </div>

          <p>${affected}</p>
          ${html}
        </form>
      `,

      allowOutsideClick: false,
      allowEscapeKey: false,
      showCancelButton: maxLength == 4 ? false : true,
      confirmButtonText: "Autenticar",
      confirmButtonClass: "btn btn-success",
      cancelButtonClass: "btn btn-default",
      cancelButtonText: "Cancelar",
      inputAttributes: {
        "data-lpignore": true,
        autocomplete: "off", //evitar el auto relleno
        autocapitalize: "off",
        autocorrect: "off",
      },
      buttonsStyling: false,
      showLoaderOnConfirm: true,
      onOpen: () => {
        //poner placeholder a swal-password
        document.getElementById("swal-password").placeholder = ph;
        $("#toggle-pass-visibility").click(() => {
          var is_visible = $("#swal-password").prop("type") == "text";
          $("#swal-password").prop("type", is_visible ? "password" : "text");
          $("#pass-visibility-icon").html(is_visible ? "visibility" : "visibility_off");
        });
        //FOCUS AL BOTON DE AUTENTICAR
        document.getElementsByClassName("swal2-confirm")[0].focus();

        // Agregar el evento de teclado (keydown) para capturar la tecla Enter
        document.addEventListener("keydown", function (event) {
          if (event.key === "Enter") {
            // Obtener el botón de confirmación del SweetAlert
            const confirmButton = document.querySelector(".swal2-confirm");
            if (confirmButton) {
              // Simular un clic en el botón de confirmación
              confirmButton.click();
            }
          }
        });
      },
      preConfirm: () => {
        return fetch(rootURL + "app/ajax/authenticate.php", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            userid: idUser,
            pass: document.querySelector("#swal-password").value,
            type,
            idCompany,
            action,
            tokenRequest: 1,
            id_affected,
          }),
        })
          .then((response) => {
            if (!response.ok) {
              throw new Error(response.statusText);
            }
            return response.json();
          })
          .then((json) => {
            let error = "Clave de acceso incorrecta";
            error += type == "restaurant" ? "" : " o ya ha sido utilizado anteriormente";
            if (json.authenticated == false) {
              throw new Error(error);
            }
            return type == "restaurant" ? json : true;
          });
      },
    })
      .then((r) => {
        return r;
      })
      .catch(swal.noop);
  }
