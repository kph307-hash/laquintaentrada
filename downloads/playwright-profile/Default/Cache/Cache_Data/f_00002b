  function testNid(type, number) {
    const validations = [/^[\d]{9}$/, /^[234][\d]{9}$/, /^[1][\d]{10,11}$/, /^[\d]{10,12}$/];
    var valid_id = true;
    if (type < 5 && type > 0) {
      valid_id = validations[type - 1].test(number);
    }
    return valid_id;
  }

  function getNidErrorMessage(typeNid, nid) {
    if (typeNid < 5 && typeNid > 0) {
      let minLen = [9, 10, 11, 10];
      let tipos = ["Ced. física", "Ced. jurídica", "DIMEX", "NITE"];

      let texto = "";
      let textoEmpezar = "";
      let textoFaltante = "";
      if (typeof nid != "string") {
        nid = nid.toString();
      }
      let startChar = nid ? nid.substr(0, 1) : "";
      switch (Number(typeNid)) {
        case 2:
          let validChars = ["2", "3", "4"];
          if (validChars.includes(startChar) == false) {
            textoEmpezar = "debe empezar con 2, 3 o 4";
          }
          break;
        case 3:
          if (startChar != "1") {
            textoEmpezar = "debe empezar con 1";
          }
          break;
      }

      if (nid.length < minLen[typeNid - 1]) {
        let faltante = minLen[typeNid - 1] - nid.length;
        textoFaltante = "mínimo " + minLen[typeNid - 1] + " dígitos (falta " + faltante + ")";
      }

      let formatArray = [];

      if (textoEmpezar) {
        formatArray.push(textoEmpezar);
      }

      if (textoFaltante) {
        formatArray.push(textoFaltante);
      }

      if (formatArray.length > 0) {
        texto = tipos[typeNid - 1] + " inválida";
        texto += " " + formatArray.join(", ");
      }

      return texto;
    }
    return "";
  }
