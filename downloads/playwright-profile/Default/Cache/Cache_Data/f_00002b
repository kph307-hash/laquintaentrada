  /**
   * Abre el visor de documentos (invoice-viewer) para mostrar e imprimir documentos
   * 
   * @param {int|string} id - ID del documento a imprimir o consecutivo (caso NC)
   * @param {int} tipo - Tipo de documento a mostrar
   * 
   * TIPOS DE DOCUMENTOS SOPORTADOS (typeVal):
   * - 1:  Factura (Impresion::FACTURA)
   * - 2:  Nota de crédito (Impresion::NOTA_DE_CREDITO)
   * - 3:  Abonos
   * - 5:  Abono de compra
   * - 11: Estado de cuenta
   * - 12: Transferencia de inventario
   * - 14: Compra o gasto
   * - 15: Contrato (Impresion::CONTRATO)
   * - 99: Ajuste manual de inventario 
   * 
   * @param {int} plantilla - ID de la plantilla a utilizar
   *   - 0: Usar plantilla guardada en el documento
   *   - 1: Carta (Letter size) - por defecto
   *   - 2: Tiquete (Ticket)
   *   - 3: Asada
   *   - 4: Pedido
   *   - 5: Formato especial
   *   - Si no se especifica y es tipo 3 (abono), usa plantilla 2 (ticket)
   *   - Si no se especifica y es tipo 1 (factura), muestra selector de plantilla
   * 
   * @param {boolean} showDownloadPDF - Si es true, muestra el botón para descargar PDF en el visor. Util para docs que no se guardan en el sistema o previsualizaciones.
   * @param {string} html - Si se proporciona, muestra este HTML en el visor en lugar de cargar el documento por ID. Útil para previsualizaciones o documentos personalizados.
   * 
   * @example
   * // Desde cotizaciones - imprimir factura con plantilla carta
   * app.modalImpresion(123, 1, 1);
   * 
   * @example
   * // Desde compras - imprimir compra con plantilla ticket
   * app.modalImpresion(456, 14, 2);
   * 
   * @example
   * // Abono - usa ticket por defecto si no se especifica plantilla
   * app.modalImpresion(789, 3);
   */
  /**
   * Opciones adicionales para modalImpresion
   * @typedef {Object} ModalImpresionOptions
   * @property {number} [id_client=0] - ID del cliente (para estado de cuenta)
   * @property {boolean} [for_checking=false] - Mostrar abonos en estado de cuenta
   * @property {boolean} [isNc=false] - Si es una nota de crédito
   * @property {number[]} [companies_to_search=[]] - IDs de empresas a buscar (estado de cuenta multiempresa)
   * @property {boolean} [show_nc=true] - Mostrar notas de crédito en estado de cuenta
   * @property {boolean} [pagadas=false] - Incluir facturas pagadas en estado de cuenta
   * @property {Object} [pdfExtraParams={}] - Parámetros extra para descarga/envío de PDF (ej: { show_mixed: 1 })
   */

  /**
   * @param {number|string} id - ID del documento
   * @param {number} tipo - Tipo de documento
   * @param {number} plantilla - ID de plantilla
   * @param {boolean} showDownloadPDF - Mostrar botón de descarga PDF
   * @param {string} html - HTML directo para previsualización
   * @param {ModalImpresionOptions} options - Opciones adicionales
   */
  async function modalImpresion(id, tipo = 1, plantilla = 0, showDownloadPDF = true, html = "", options = {}) {
    // Extraer opciones con valores por defecto
    const {
      id_client = 0,
      for_checking = false,
      isNc = false,
      companies_to_search = [],
      show_nc = true,
      pagadas = false,
      pdfExtraParams = {},
      index = 0,
      numResults = 0,
    } = options;

    if (!plantilla && tipo == 3) {
      //si es un abono
      plantilla = 2; //los abonos por defecto son ticket
    } else if (!plantilla && tipo == 1) {
      //si es una factura a contado sin plantilla
      let templateSelected = await select_template(); //se abre la funcion apra elegir tipo de impresion
      plantilla = templateSelected.id;
    } else if (!plantilla) {
      plantilla = 1; //po defecto tipo carta
    }

    // Cargar invoice-viewer dinámicamente si no está disponible
    if (!window.invoiceViewer) {
      // En Vue 3, intentar cargar el módulo ES6
      if (typeof VUE_VERSION !== "undefined" && VUE_VERSION == 3) {
        try {
          const { initInvoiceViewer } = await import("components/invoice-viewer.js?v=1.0.6");
          window.invoiceViewer = initInvoiceViewer(typeof rootURL !== "undefined" ? rootURL : "/");
        } catch (e) {
          console.error("Error cargando invoice-viewer:", e);
        }
      }
    }

    if (window.invoiceViewer && typeof window.invoiceViewer.preview === "function") {
      console.log("visor documentos cargado, abriendo vista previa");
      const htmlEmpty = !html || html.trim() === "";
      
      // Configurar type_doc_pdf antes de preview
      if (!showDownloadPDF) {
        window.invoiceViewer.type_doc_pdf = 0;
      } else {
        window.invoiceViewer.type_doc_pdf = tipo;
      }

      // Configurar pdfExtraParams si se proporcionaron
      if (Object.keys(pdfExtraParams).length > 0) {
        window.invoiceViewer.pdfExtraParams = pdfExtraParams;
      } else {
        window.invoiceViewer.pdfExtraParams = {};
      }

      if (!htmlEmpty) {
        window.invoiceViewer.previewWithHTML(html, plantilla, showDownloadPDF);
      } else {
        // Llamar preview con todos los parámetros soportados
        window.invoiceViewer.preview(
          id,
          plantilla,
          tipo,
          index,                    // index
          numResults,                    // numResults
          id_client,
          for_checking,
          isNc,
          companies_to_search,
          show_nc,
          pagadas
        );
      }
    } else {
      $.notify(
        {
          icon: "error",
          message: "No se pudo cargar el visor de documentos. Por favor intente recargando la página. Si el error persiste, contacte al soporte técnico.",
        },
        {
          type: "danger",
          timer: 5000,
          placement: {
            from: "top",
            align: "center",
          },
        },
      );
      console.error("invoiceViewer no está inicializado correctamente");
    }
  }
  

