   * Funcion para realizar un post mediante fetch con el token JWT
   * @param {String} url el Url al que se necesita mandar el post
   * @param {Object} data  los datos que se van a enviar
   * @param {Boolean} json  si se necesito que esos datos se manden como json
   * @param {Boolean} post  si el fetch se va  a hacer como un post o un get
   * @param {Boolean} resText  si ese necesita que el response sea devuelvo como text en lugar de Json, es especialmente util cuando el backend devuelve HTML , por ejemplo en facturas/impresiones
   * @returns retorna los datos que responde el backend
   */

  function postWithFetchJwt(url, data, json = false, post = true, resText = false) {
    const jwt = app.getJWT();
    var requestOptions = {
      method: post ? "POST" : "GET",
      headers: {
        Authorization: "Bearer " + jwt,
      },
    };
    if (post) requestOptions.body = json ? JSON.stringify(data) : new URLSearchParams(data);

    return fetch(url, requestOptions)
      .then((response) => {
        if (resText) {
          return response.text();
        } else {
          return response.json();
        }
      })
      .then((data) => {
        return data;
      })
      .catch((error) => {
        throw error;
      });
  }

  let machineId;

  function getMachineId() {
    return new Promise(async (resolve, reject) => {
      if (machineId) {
        resolve(machineId);
      } else {
        await enableDbApp();
        const store = await dbApp.store.where("key").equals("machineId").toArray();
        let action = false;
        let mid;
        if (store.length) {
          const expiration = moment(store[0].expiration);
          const now = moment();
          const expired = expiration < now;
          mid = store[0].machineId;
          machineId = mid;
          if (!expired && mid) {
            resolve(mid);
          } else {
            action = "register";
          }
          expiration.subtract(2, "days");
          if (expiration < now) {
            action = "renew";
          }
        } else {
          action = "register";
        }

        if (action) {
          const form = new FormData();
          form.append("action", action);
          form.append("type", "1");
          if (mid) form.append("machineId", mid);
          fetch(serverURL + "/app/ajax/machineRegistrations.php", {
            method: "POST",
            body: form,
            headers: {
              Authorization: "Bearer " + getJWT(),
            },
          })
            .then((r) => {
              if (!r.ok) {
                reject(r.statusText);
                throw new Error("Error de servidor al consultar machineRegistrations");
              }
              return r.json();
            })
            .then((r) => {
              dbApp.store.put({
                key: "machineId",
                machineId: r.machineId,
                expiration: r.expiration,
              });
              machineId = r.machineId;
              if (!mid) {
                resolve(r.machineId);
              }
            })
            .catch((e) => {
              console.error(e.message);
              reject("Server error");
            });
        }
      }
    });
  }

  let lastTimestamp;
  let lastSequence;
  async function generateKey(n = 1) {
    // --timestamp--type--clientId--sequence
    // -----36-------1------20---------7----
    await enableDbApp();
    let timestamp = Math.floor(Date.now() / 100);
    if (lastTimestamp && lastTimestamp > timestamp) timestamp = lastTimestamp;
    const machineId = BigInt(await getMachineId());
    let sequence = lastSequence || 0;
    if (!lastSequence) {
      const store = await dbApp.store.get("keySequence");
      if (store && store.length) {
        sequence = store[0].sequence;
      }
    }
    const keys = [];
    for (let i = 0; i < n; i++) {
      const hex = (BigInt(timestamp) << 28n) | (machineId << 7n) | BigInt(sequence);
      keys.push(hex.toString(10));
      sequence = (sequence + 1) % 127;
      if (sequence == 0) timestamp++;
    }
    lastSequence = sequence;
    lastTimestamp = timestamp;
    dbApp.store.put({
      key: "keySequence",
      sequence,
    });
    return n > 1 ? keys : keys[0];
  }
  /**
   * Funcion para copiar al portapapeles
   * Soporta:
   * - Android
   * - Navegadores modernos
   * - Navegadores antiguos (IE)
   * @param {String} str Texto a copiar al portapapeles
   */
  async function copyToClipboard(str) {
    try {
      if (typeof Android === "object" && Android.copyToClipboard) {
        // Si es Android, usar el método nativo
        Android.copyToClipboard(str);
        showNotification("success", "Contenido copiado al portapapeles");
      } else if (navigator.clipboard && navigator.clipboard.writeText) {
        // Si el navegador soporta la API Clipboard
        await navigator.clipboard.writeText(str);
        showNotification("success", "Contenido copiado al portapapeles");
      } else {
        // Método de respaldo para navegadores antiguos
        const tempInput = document.createElement("textarea");
        tempInput.value = str;
        document.body.appendChild(tempInput);
        tempInput.select();
        document.execCommand("copy");
        document.body.removeChild(tempInput);
        showNotification("success", "Contenido copiado al portapapeles");
      }
    } catch (error) {
      console.error("Error al copiar al portapapeles:", error);
      showNotification("danger", "No se pudo copiar el texto. Inténtelo de nuevo.");
    }
  }

