  async function getOrderedCategories() {
    let categories = await app.getDb().categories.toArray();
    //ordenamos segun el nombre con prioridad alfabetica y Subcategorias
    categories.sort((a, b) => {
      let pathA = a.nm.split("/");
      let pathB = b.nm.split("/");
      let len = Math.min(pathA.length, pathB.length);
      for (let i = 0; i < len; i++) {
        let cmp = pathA[i].localeCompare(pathB[i]);
        if (cmp !== 0) {
          return cmp;
        }
      }
      return pathA.length - pathB.length;
    });
    return categories;
  }

