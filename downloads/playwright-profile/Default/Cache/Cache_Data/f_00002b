    $("html").attr("data-theme", isDarkMode ? "dark" : "light");
    localStorage.setItem(prefix + idUser + "-dark-mode", isDarkMode ? "1" : "0");
    let cookieValue = getCookieValue("user-prefs") || "0";
    cookieValue = parseInt(cookieValue);
    cookieValue &= ~DARKMODE;
    cookieValue |= (isDarkMode ? 1 : 0) * DARKMODE;
    setCookie("user-prefs", cookieValue);
  }

