async function handleIsPrefactura(id, lugar, plantilla) {
  let htmlContent = document.getElementById("invoice").contentWindow.document.documentElement.innerHTML;

  let res = await fetch(`${serverURL}/app/recepcion/downloadPDF.php`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      id: id,
      lugar: 99,
      plantilla: plantilla,
      html: htmlContent,
      isPrefactura: true,
    }),
  });

  if (!res.ok) {
    throw "Server error";
  }

  return res;
}

async function compartirPDF(id, lugar, plantilla = 0) {
  try {
    if (typeof Android == "object") {
      let res;
      if (typeof isPrefactura != "undefined" && isPrefactura) {
        res = await handleIsPrefactura(id, lugar, plantilla);
      } else if (typeof impresion_lote != "undefined" && impresion_lote) {
        //agarramos el html del iframe
        let iframe = document.getElementById("invoice");
        let innerDoc = iframe.contentDocument || iframe.contentWindow.document;
        let htmlContent = `<html>${innerDoc.documentElement.innerHTML}</html>`;
        //ponerle el DocType para que no de error al imprimir
        htmlContent = htmlContent.replace("<html>", "<!DOCTYPE html><html>");
        res = await fetch(`${serverURL}/app/recepcion/downloadPDF.php`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            id: id,
            lugar: 99,
            plantilla: plantilla,
            html: htmlContent,
            impresion_lote: true,
          }),
        });
      } else {
        res = await fetch(docDownloadURL(id, lugar, plantilla));
      }

      if (!res.ok) {
        throw "Server error";
      }

      let pdfBlob = await res.blob();
      const cd = res.headers.get("Content-Disposition");
      const filename = cd.substring(cd.indexOf('"') + 1, cd.length - 1);
      Android.showToast(filename);

      var reader = new FileReader();
      let pdf = new File([pdfBlob], filename, {
        type: "application/pdf",
      });
      reader.readAsDataURL(pdf);
      reader.onloadend = function () {
        var base64data = reader.result;
        Android.share(base64data, filename);
      };
    } else {
      if (navigator.canShare) {
        let res;
        if (typeof isPrefactura != "undefined" && isPrefactura) {
          res = await handleIsPrefactura(id, lugar, plantilla);
          isPrefactura = false;
        } else {
          res = await fetch(docDownloadURL(id, lugar, plantilla));
        }
        if (!res.ok) {
          throw "Server error";
        }

        let pdfBlob = await res.blob();
