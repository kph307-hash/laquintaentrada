      async function updatePrintChannels(localPrinters) {
        let updateStorage = false;
        const storagePath = `${uuidCompany}_printerChannels`;
        for (var id_channel in localPrinters) {
          var printer = localPrinters[id_channel];
          if (!printer.type) {
            printer.type = 1; //poner por defecto tipo comanda
          }
          var channel = channels.find((channel) => channel.id == id_channel);
          if (channel) {
            //ya existe el canal, solo actualizamos la impresora y la plantilla
            channel.printer = printer;
            channel.template = printer.template ? printer.template : printer.size ? printer.size : 1;
          } else {
            //es un canal que aun no esta suscrito
            var pusherChannel = pusher.subscribe(`private-print-${idCompany}-${id_channel}`);
            let bindChannel = null;
            switch (Number(printer.type)) {
              case 1:
                bindChannel = "command";
                break;
              case 2:
                bindChannel = "pre-bill";
                break;
              case 3:
                bindChannel = "bill";
                break;
              case 4:
                bindChannel = "purchase-order";
                break;
            }
            if (!bindChannel) return; //por alguna razon no se encontro el canal

            pusherChannel.bind(
              bindChannel,
              function (d) {
                semaphore.callFunction(doPrint, d, this.id_channel);
              },
              {
                id_channel,
              },
            );

            var timeAdded;
            if (printer.timeAdded) {
              timeAdded = printer.timeAdded;
            } else {
              //no tiene, se le agrega de una vez
              timeAdded = await getServerDate().catch((e) => moment().format());
              printer.timeAdded = moment(timeAdded).unix();
              updateStorage = true;
            }

            channels.push({
              printer: {
                name: printer.name,
              },
              timeAdded,
              id: id_channel,
              pusher: pusherChannel,
              type: Number(printer.type),
              print_twice: Number(printer.print_twice || 0),
              template: Number(printer.size || printer.template || 1), //para mantener compatibilidad con versiones anteriores
            });
          }

          if (updateStorage) {
            //actualizar local storage
            localStorage.setItem(storagePath, JSON.stringify(localPrinters));

            //guardar en un archivo con navedi
            navedi.file.write(storagePath + ".json", {
              data: JSON.stringify(localPrinters),
            });
          }
        }

        // Eliminar canales que ya no estan suscritos
        var channelsToDelete = channels.filter((channel) => !localPrinters[channel.id]);
        channelsToDelete.forEach((channel) => {
          channel.pusher.unbind(); //quitar todos los eventos
          channel.pusher.unsubscribe(); //desuscribir
          channels = channels.filter((ch) => ch.id != channel.id);
        });
      }

