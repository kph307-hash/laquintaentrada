    console.error(e);
    $.notify("Error al enviar correo", { type: "danger" });
  }
  if (abrirModal) {
    $(abrirModal).modal("show");
  }
}

function docDownloadURL(id, lugar, plantilla, recepcion, extraParams = {}) {
  if (id == 0) {
    id = id_documento_elegido;
  }
  if (lugar == 0) {
    lugar = lugar_PDF_documento_elegido;
  }
  if (plantilla == 0) {
    plantilla = plantilla_documento_elegido;
  }

  if (extraParams && Object.keys(extraParams).length == 0) {
    extraParams = extraParamsPDF || {};
  }

  let url;
  if (lugar == 4) {
    let product_check_pdf = typeof product_check != "undefined" && product_check;
    url = `${serverURL}/app/modules/compras/bin/compra_pdf.php?id=${id}&recepcion=${recepcion}&product_checking=${product_check_pdf ? 1 : 0}`;
  } else if (lugar == 6 || lugar == 7) {
    //6 = alistada, 7= cargada
    url = `${serverURL}/app/modules/rutas/printRutasActions.php?action=${lugar == 6 ? 1 : 2}&id=${id}&pdf=1`;
  } else if (lugar == 12) {
    url = `${serverURL}/app/modules/ventas/impresion_factura.php?id=${id}&p=${plantilla}&tipo=${lugar}&to_pdf=1`;
  } else {
    url = `${serverURL}/app/recepcion/downloadPDF.php?id=${id}&lugar=${lugar}&plantilla=${plantilla}&idClient=${id_client_PDF}`;
  }

  if (Object.keys(extraParams).length > 0) {
    url += "&" + new URLSearchParams(extraParams).toString();
  }
  return url;
}

