    } else if (tipo == 2) {
      return c.substr(0, 1) + "-" + c.substr(1, 3) + "-" + c.substr(4);
    } else if (tipo == 3) {
      return c.substr(0, 3) + "-" + c.substr(3, 3) + "-" + c.substr(6);
