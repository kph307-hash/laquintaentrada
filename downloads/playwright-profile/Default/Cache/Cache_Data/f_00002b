            let fecha;
            let finalDUe;
            let cuotasRestantes = d.pago.datos.plazo;
            const calcularCuotaFinal = (fecha, cuotasRestantes, tipoExpiracion) => {
              let fechaFinal = fecha.clone(); // Clonar la fecha inicial
              // Iteramos sobre las cuotas
              while (cuotasRestantes > 1) {
                if (tipoExpiracion == 2) {
                  // es quincenal
                  fechaFinal.add(15, "days"); // Avanzamos 15 días
                } else if (tipoExpiracion == 3) {
                  //es semanal
                  fechaFinal.add(1, "weeks"); // Avanzamos 1 semanas
                } else if (tipoExpiracion == 1) {
                  // es mensual
                  fechaFinal.add(1, "month");
                }
                cuotasRestantes--;
              }
              return fechaFinal.format("DD/MM/YYYY");
            };

            if (tipoExpiracion == 2) {
              // es quincenal
              if (todays_date >= 15 && todays_date < 30) {
                if (dateFact.month() == 1) {
