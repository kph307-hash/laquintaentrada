  //esta funcion es para copiar al portapales o compartir a otras aplicaciones
  async function shareInfo(action = 1, data, file = "text", filename = "") {
    /*
        Tipo de action:
            1 = copiar al portapales
            2= compartir a otras aplicaciones
        Data:
            Los datos a compartir, se espera que sea un String
        file:
            El tipo de archivo a compartir , puede ser text, url, o files (pdf,etc);
        filename:
            El Titulo que tendra
        */
    if (action == 1) {
      if (typeof Android == "object") {
        //si es la app android usamos el metodo realizaod en la app
        console.log("es android");
        Android.copyToClipboard(data);
      } else {
        if (navigator.clipboard) {
          //verificamos si el nav aguanta el metodo clipboard
          //en caso de querer copiar a portapaples, solo usamos el data
          navigator.clipboard
            .writeText(data)
            .then(() => {
              swal("Copiado con exito", "Texto copiado al portapales", "success");
            })
            .catch((err) => {
              console.log(err);
              console.log(err.message);
              swal("Ha ocurrido un error", "Intentelo de nuevo", "error");
            });
        } else {
          //en caso de que el nav no soporte la funcion , usamos un metodo tradicional
          var dummy = document.createElement("input");
          document.body.appendChild(dummy);
          dummy.setAttribute("value", data);
          dummy.select();
          document.execCommand("copy");
          document.body.removeChild(dummy);
        }
      }
    }
    if (action == 2) {
      //en caso de querer compartirlo
      try {
        if (typeof Android === "object") {
          // estamos en WebView Android: llamamos al método nativo
          if (file === "text") {
            Android.shareText(data, filename);
          } else if (file === "url") {
            Android.shareUrl(data, filename);
          }
          return; // Salimos de la función después de llamar al método nativo
        }
        let objToExport = {
          title: filename,
        };
        /*
                se pueden crear mas metodo en caso de ser necesario, y se pueden combinar las propiedas, no son excluyentes,
                por ejemplo:
                    navigator.share({
                        title: title,
                        text: text,
                        url: url,
                        file : file
                    });
                En nuestro caso:
                    objToExport['text'] = eldato;
                    objToExport['url'] = eldato;
                */
        if (file == "text") {
          objToExport["text"] = data;
        }
        if (file == "url") {
          objToExport["url"] = data;
        }
        if (navigator.canShare) {
          navigator.share(objToExport);
        } else {
          $.notify("Su dispositivo no soporta la funcionalidad de compartir ", { type: "info" });
        }
      } catch (e) {
        console.error(e);
        $.notify("Error al compartir", { type: "danger" });
      }
    }
  }
  /**
   * Metodo para mostrar alarmas y notificaciones.
   *
   * @param {string} alarm La accion a realizar, por defecto alarm. la otra utilizada es proforma carrito
   * @return {component}  Devuelve una alarma .
   */
  async function alarmNotification(action = "alarm") {
    //no hacer peticion en modulo de centro de cobros pare vitar sobreescribir el token
    if (location.pathname.indexOf("/centro_cobros") !== -1) return;
    const form = new FormData();
    form.append("action", action);
    //obtenemos las alarmas
    if (app.getJWT()) {
      await fetch(serverURL + "/app/ajax/getAlarms.php", {
        method: "POST",
        body: form,
        headers: {
          Authorization: "Bearer " + app.getJWT(),
        },
      })
        .then((response) => {
          if (!response.ok) {
            throw new Error("Error al consultar alarmas");
          }
          return response.json();
        })
        .then(async (data) => {
          var eventos = await data;
          if (eventos.length == 0 && action == "alarm") return; //en caso de que no exista
          if (eventos.count == 0 && action == "proforma_carrito") return; //en caso de que no exista
          if (typeof Android == "object") {
            //aqui viene lo de android
            var JsonEvents = JSON.stringify(eventos);
            if (action == "alarm") {
              Android.alarmEvents(JsonEvents);
            } else {
              Android.showNotification(JsonEvents);
            }
          } else {
            //verificamos si el nav soporta la Notificaciones
            if ("Notification" in window) {
              //pedimos los permisos
              let pasa = await Notification.requestPermission();
              if (pasa == "granted") {
                /*Si las notificaciones no salen y ESTA USANDO GOOGLE CHROME y windows 10, debes activar las opcion "obtener notificaiciones de aplicaciones "
                                En Notificaciones y Acciones de windows 10, esto solo aplicar para el entonro de Developer
                            */
                if (action == "alarm") {
                  const audio = new Audio(rootURL + "/app/assets/sounds/alarmSound.wav"); //cargamos el audio
                  for (i in eventos) {
                    //recorremos los eventos
                    let evento = eventos[i];
                    //pasamos la fecha a milisegundos
                    let date_event = new Date(evento.date_start);
                    let now = new Date().getTime();
                    let diff = date_event.getTime() - now; //obtenemos la diferencia en milisegundos para saber entre cuanto tiempo se debe activar alarma
                    let id_event = evento.id_event;
                    let desc = "Evento: " + evento.detalle + ", asociado al cliente: " + evento.name_client;
                    let data = {
                      body: desc,
                      icon: rootURL + "/app/assets/img/bell_2.png",
                    };
                    //obtenemos el nombre para el local storage
                    let name = "alarm-" + id_event;
                    let done = false;
                    if (localStorage.getItem(name)) {
                      done = true;
                    } else {
                      localStorage.setItem(name, false);
                    }
                    //en caso de que no se haya ejecutado, hacemos la notificaciones
                    if (done === false) {
                      let time = setTimeout(function () {
                        //creamos la notificacion
                        let noti = new Notification("¡Recordatorio de evento!", data);
                        noti.addEventListener("show", function () {
                          localStorage.setItem(name, true);
                          if (audio != "") {
                            audio.play();
                          }
                        });
                      }, diff);
                    }
                  }
                } else {
                  //cualquier otro evento diferente a alarma
                  const audio = new Audio(rootURL + "/app/assets/sounds/notificationSoud.wav"); //cargamos el audio
                  let desc = eventos.detalle; //obtenemos las desc que viene de la bd

                  let url = "/app/assets/img/bell_2.png";
                  if ((action = "proformas_carrito")) url = "/app/assets/img/shopping_cart.png";

                  let data = {
                    body: desc,
                    icon: rootURL + url,
                  };
                  let noti = new Notification("¡Nueva notificación!", data);
                  noti.addEventListener("show", function () {
                    if (audio != "") {
                      audio.play();
                    }
                  });
                  //al hacer click
                  noti.onclick = (event) => {
                    swal({
                      title: "¿Estás de acuerdo?",
                      type: "info",
                      text: `Serás redireccionado al listado de proformas en punto de venta`,
                      confirmButtonClass: "btn btn-info",
                      confirmButtonText: "Si, deseo avanzar",
                      cancelButtonClass: "btn",
                      cancelButtonText: "Cancelar / volver",
                      buttonsStyling: false,
                      showCancelButton: true,
                      preConfirm: () => {
                        event.preventDefault(); // prevent the browser from focusing the Notification's tab
                        if (action == "proformas_carrito") window.location.replace("modules/punto_de_venta/index.php?action=showProforma");
                      },
                    });
                  };
                }
              } else if (pasa == "denied") {
                var lastShown = localStorage.getItem("lastShown");
                var now = new Date();
                if (!lastShown || new Date(lastShown).getDate() !== now.getDate()) {
                  $.notify("Recuerda activar las notificaciones para poder recordarte tus eventos ", { type: "info", delay: 2000 });
                  localStorage.setItem("lastShown", now.toString());
                }
              }
            }
          }
        })
        .catch((error) => console.error(error));
    }
  }

