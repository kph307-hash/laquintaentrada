export default {
    since: false,
    data() {
        return{
            search: '',
            companies: [],
            initialized: false,
            idUser: idUser
        }
    },
    template: `
        <div class="content companies" id="vSearch">
        <div class="dashboard-header absolute-access">
            <div class="header-content">
                <h3 v-if="initialized" class="text-header mov-h3" style="text-align: center;font-weight: 500;display:none" :style="{display: 'block'}">
                    {{companies.length ? 'Accede a una empresa' : '¡Bienvenido! <?php echo $settings['app_name'] ?>'}}
                </h3>
            </div>
        </div>
        <div class="container-fluid">
            <div style="display:none" class="col-lg-8 col-lg-offset-2" :style="{display: 'block'}">
                <br>
                <div class="row" v-if="companies.length > 0">
                    <div class="col-sm-offset-2 col-sm-8 col-lg-6 col-lg-offset-3">
                        <div class="form-group is-search">
                            <input type="text" placeholder="Buscar empresa" class="form-control" v-model="search" autofocus>
                            <span class="material-icons form-control-feedback">search</span>
                        </div>
                    </div>
                </div>
                <div v-if="companies.length == 0 && initialized">
                    <div class="row">
                        <div class="boxEjemplo alert-dismissible col-sm-8 col-sm-offset-2" role="alert">
                            <strong>Primeros pasos para usar <?php echo $settings['app_name'] ?>:</strong><br>
                            - Crea una empresa o dale clic a <strong>Crear Primera Empresa</strong>
                            <br>- Sigue los pasos que se te mostraran para la creación de la empresa.
                        </div>
                        <div class="col-md-12 text-center">
                            <button type="button" @click='crear_empresa()' class="btn btn-success btn-lg btn-round"><span class="material-icons">add_business</span> Crear primera empresa </button>
                        </div>
                    </div>
                </div>
                <div class="row" v-show='filtered_companies.lenght > 0'>
                    <p class="text-center"><strong> Por favor, dar clic en el nombre de la empresa a la que deseas ingresar. </strong></p>
                </div>
                <br>
                <div>
                    <div v-for="(r, i) in filtered_companies" class="generic-selects row company" :class="{blocked: r.status==='BL' || r.status_user == 'DL'}" @click="login(i)">
                        <div class="col-sm-1">
                            <a v-if="r.status!=='BL' && r.status_user == 'AC' " class="to_access bubble-float-right" title="Acceder"><span class="material-icons">login</span></a>
                            <a v-else-if="r.status==='BL' || r.status_user == 'DL'" class="to_block" title="Bloqueado"><span class="material-icons">block</span></a>
                        </div>
                        <div class="col-sm-4">
                            <p>{{ r.fantasy }}</p>
                        </div>
                        <div class="col-sm-4">
                            <p>{{ r.name }}</p>
                        </div>
                        <div class="col-sm-2">
                            <p>{{ r.nid_company }}</p>
                        </div>
                        <div class="generic-clear col-sm-1 hidden-xs">
                            <button class="btn generic-clear btn-just-icon" title="Eliminar empresa" @click.stop="delete_empresa(i)"><i class="fa fa-times" aria-hidden="true"></i></button>
                        </div>
                    </div>
                    <br>
                    <div class="col-md-12 text-center">
                        <button type="button" onclick='modalSupport()' class="btn btn-outline-warning btn-round">Soporte Técnico</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    `,
    computed: {
        filtered_companies: function() {
            const r = new RegExp(this.search, 'i');
            return this.companies.filter(c => {
                return r.test(c.name) || r.test(c.fantasy) || r.test(c.nid_company);
            });
        }
    },
    methods: {
        load_companies_list() {
            let self =this;
            $.post('../admin/bin/buscar_empresas_de_usuario.php', {
                user: this.idUser,
                since: this.since
            }).then(d => {
                if (d.since) {
                    self.since = d.since;
                }
                if (d.list.length) {
                    self.companies = d.list;
                }
                self.initialized = true;
            });
        },
        login: function(i) {
            let self =  this;
            const cp = this.filtered_companies[i];
            if(cp.status_user == 'DL'){
                const authDl = new Promise(resolve => {
                    //mostrar alerta de que su usuario fue eliminado
                    return app.requestAuth(
                        'admin',
                        'Tu usuario fue eliminado de esta empresa,se ha enviado una solicitud de ingreso. Por favor contacta al administrador de la empresa para reactivar tu usuario mediante la clave ',
                        98,
                        idUser,
                        cp.id
                    ).then(r => {
                        if (r) {
                            localStorage.setItem(cp.id + '_userauth_' + idUser, btoa(cp.id + '_' + idUser));
                        };
                        resolve(r);
                    });
                });
                authDl.then(a => {
                    if (!a) return;
                    self.doLogin(cp, localStorage.getItem(cp.id + '_userauth_' + idUser), i);
                });
            }
            if (cp.status != 'BL') {
                if (cp.req_auth) {
                    const auth = new Promise(resolve => {
                        if (localStorage[cp.id + '_userauth_' + idUser]) {
                            resolve(true);
                        } else {
                            return app.requestAuth(
                                'admin',
                                'Permiso de un administrador requerido para iniciar sesión por primera vez en este dispositivo.',
                                98,
                                idUser,
                                cp.id
                            ).then(r => {
                                if (r) {
                                    localStorage.setItem(cp.id + '_userauth_' + idUser, btoa(cp.id + '_' + idUser));
                                };
                                resolve(r);
                            });
                        }
                    });
                    auth.then(a => {
                        if (!a) return;
                        self.doLogin(cp, localStorage.getItem(cp.id + '_userauth_' + idUser), i);
                    });
                } else {
                    this.doLogin(cp);
                }
            } else {
                if (cp.use_private_support == 1 && cp.status_sub == "SUSP") {
                    // En mi opionion, super mala forma de hacerlo, pero como no me afecta, lo dejo asi
                    let suspensionText = "<strong>La suscripción asociada a esta empresa ha sido suspendida debido a morosidad del representante revendedor.</strong>";
                    if (cp.suspension_reason) {
                        suspensionText += "<br><br><strong>Motivo de la suspensión:</strong> " + cp.suspension_reason;
                    }
                    swal({ //tiene soporte privado pero la suscripcion madre esta bloqueada
                        title: '¡Suscripción suspendida!',
                        text:
                        suspensionText +
                        "<br><br><strong>" + cp.reseller_name_c + "</strong>, representada por <strong>" + cp.reseller_name + "</strong>, alquila y revende la plataforma Facture.cr bajo un contrato independiente. " +
                        "El impago de sus obligaciones contractuales ha generado la suspensión temporal de los servicios vinculados." +

                        "<br><br><u>Importante:</u> Facture.cr y <strong>" + cp.reseller_name_c + "</strong> son empresas distintas. Conforme a la Ley 7472 de Promoción de la Competencia y Defensa Efectiva del Consumidor, " +
                        "toda obligación de pago y soporte frente a sus clientes corresponde exclusivamente al revendedor." +

                        "<br><br>Ante cualquier daño o perjuicio derivado de esta suspensión, <strong>" + cp.reseller_name + "</strong> —representante de <strong>" + cp.reseller_name_c + "</strong>— asume la responsabilidad correspondiente." +

                        "<br><br><strong>Contacto del representante:</strong><br>" +
                        "• WhatsApp: <a href=\"" + cp.whatsapp_href_c + "\">" + cp.whatsapp_label_c + "</a><br>" +
                        "• Correo: " + cp.email_reseller + "." +

                        "<br><br>Si necesita asistencia adicional de Facture.cr, pulse el botón <em>“Más ayuda…”</em> y con gusto le atenderemos.",
                        confirmButtonClass: 'btn btn-info',
                        confirmButtonText: 'Más ayuda...',
                        buttonsStyling: false
                    }).then(r => {
                        if (r) modalSupport(cp.id)
                    }).catch(swal.noop);
                } else if (cp.use_private_support == 0) { //Si no tiene soporte privado
                    let text = '<br>Esta empresa fue bloqueada automáticamente.';
                    if (cp.is_trial) {
                        text += ` se encuentra en periodo de prueba, el cual ha expirado. `;
                        text += `Necesitarás comprar una suscripción para poder seguir usando esta cuenta.`;
                    } else {
                        
                        if (cp.suspension_reason) {
                            text += `<br><br><strong>Motivo de la suspensión:</strong> ${cp.suspension_reason}`;
                        }
                        if (cp.id_sub) {
                            text += `<br><br><a href="javascript:;" class="btn btn-primary btn-lg" onclick="modalPago(${cp.id})">Registrar pago</a><br><br>`;
                            text += `Una vez resuelto el inconveniente la empresa quedará activada automáticamente mientras nuestro equipo de soporte verifica la situación.`;
                        }
                    }
                    text += `<br><br>Puedes comunicarte con nosotros por alguno de nuestros <strong><a href="#" onclick="modalSupport(${cp.id})">medios de soporte al cliente</a></strong>,`;
                    text += ` o contáctanos directamente vía <strong><a href="${cp.whatsapp_href}">WhatsApp al ${cp.whatsapp_label}</a></strong>.`;
                    swal({
                        title: '¡Suscripción suspendida!',
                        html: text,
                        confirmButtonClass: 'btn btn-info',
                        confirmButtonText: 'Más ayuda...',
                        buttonsStyling: false
                    }).then(r => {
                        if (r) modalSupport(cp.id)
                    }).catch(swal.noop);
                } else { //Si tiene soporte privado mostarle la informacion correspondiente al revendedor 
                    swal({
                        title: '¡Oh no!',
                        text: 'Esta empresa fue bloqueada automáticamente ya que no se ha registrado el pago del plan ' + cp.plan_text_workgroup + '. <h3><strong><a class="text-info" href=\"#\" onclick=\"modalPagoWorkgroup(' + cp.id + ')\">CLIC AQUÍ PARA REGISTRAR EL PAGO</a></strong></h3> Una vez hecho esto la empresa quedará activada automáticamente mientras nuestro equipo de soporte verifica el pago registrado. También puedes comunicarte con nosotros por alguno de nuestros <strong><a href=\"#\" onclick=\"modalSupport(' + cp.id + ')\">medios de soporte al cliente</a></strong>. <br><br>' +
                            'O contáctanos directamente vía <strong><a  href=\"' + cp.whatsapp_href + '\">WhatsApp al ' + cp.whatsapp_label + '</a></strong> para mas información. <br><br>Estamos para servirte.',
                        confirmButtonClass: 'btn btn-info',
                        confirmButtonText: 'Más ayuda...',
                        buttonsStyling: false
                    }).then(r => {
                        if (r) modalSupport(cp.id)
                    }).catch(swal.noop);
                }
            }
        },
        doLogin: function(cp) {
            const form = new FormData();
            form.append('id', cp.id);
            form.append('_token', _TOKEN);
            fetch('user/update_user_login.php', {
                method: 'POST',
                body: form
            }).then(r => {
                if (!r.ok) {
                    throw new Error(`Ocurrió un error al intentar contactar al servidor`);
                }
                return r.json();
            }).then(r => {
                if (r.authenticated) {
                    if (r.jwt) app.setJWT(r.jwt, cp.uuid);
                    if (typeof BroadcastChannel == 'function') {
                        const bc = new BroadcastChannel('session_change');
                        bc.postMessage(cp.id);
                    }
                    window.history.go(0);
                } else if (r.msg) {
                    throw new Error(r.msg);
                } else {
                    throw new Error('No tienes acceso a la empresa.');
                }
            }).catch(e => {
                $.notify(e, {
                    type: 'danger'
                })
            });
        },
        crear_empresa: function() {
            window.location.replace("modules/configuracion/index.php?tt=add");
        },
        removeCompany: function(id) {
            this.companies = this.companies.filter(c => {
                return c.id !== id;
            });
        },
        delete_empresa: function(i) {
            let self = this;
            const comp = this.filtered_companies[i];
            swal({
                title: '¡Atención!',
                type: "warning",
                text: `¿Desea desvincularse de la empresa <b>${comp.fantasy}</b>? Esta acción hará que no pueda volver a acceder a esta empresa.`,
                confirmButtonClass: 'btn btn-danger',
                confirmButtonText: 'Si, deseo desvincularme',
                cancelButtonClass: 'btn',
                cancelButtonText: "Cancelar",
                buttonsStyling: false,
                showCancelButton: true,
                preConfirm: () => {
                    return $.post("ajax/delete_empresa.php", {
                        comp: JSON.stringify(comp),
                        delete_comp: 'false'
                    }, (d) => {
                        return d;
                    });
                }
            }).then(function(d) {
                if (d.error) {
                    swal({
                        title: '¿Desea eliminar la empresa?',
                        type: "warning",
                        text: d.error,
                        confirmButtonClass: 'btn btn-danger',
                        confirmButtonText: 'Si, deseo eliminarla',
                        cancelButtonClass: 'btn',
                        cancelButtonText: "Cancelar",
                        buttonsStyling: false,
                        showCancelButton: true,
                        preConfirm: () => {
                            return $.post("ajax/delete_empresa.php", {
                                comp: JSON.stringify(comp),
                                delete_comp: 'true'
                            }, (d) => {
                                return d;
                            });
                        }
                    }).then(function(result) {
                        if (result.success) {
                            swal({
                                title: "Empresa eliminada",
                                type: "success",
                                confirmButtonClass: 'btn btn-danger',
                                confirmButtonText: 'Ok.',
                                buttonsStyling: false
                            }).catch(swal.noop);
                            self.removeCompany(comp.id);
                        } else {
                            console.log(result);
                        }
                    }).catch(swal.noop);
                } else {
                    swal({
                        title: "Empresa desvinculada",
                        type: "success",
                        confirmButtonClass: 'btn btn-danger',
                        confirmButtonText: 'OK',
                        buttonsStyling: false
                    }).catch(swal.noop);
                    self.removeCompany(comp.id);
                }
            }).catch(swal.noop);
        },

    },
    mounted: function() {

        this.load_companies_list();
        window.setInterval(() => {
            this.load_companies_list();
        }, 15000)
    }
};