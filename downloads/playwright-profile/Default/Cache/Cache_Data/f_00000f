.hr-color {
    height: 6px;
    margin-top: -6px !important;
    background-color: #000c8a;
}
.hr-color1 {
    height: 4px;
    background-color: #ffffff;
}
.hr-color2 {
    height: 8px;
    background-color: #db2416;
}
.hr-color3 {
    height: 4px;
    background-color: #ffffff;
}
.hr-color4 {
    height: 6px;
    background-color: #000c8a;
}

.hr-color,
.hr-color1,
.hr-color2,
.hr-color3,
.hr-color4 {
    position: relative;
    overflow: hidden;
    border: none;
    margin: 0;
}

.hr-color::after,
.hr-color1::after,
.hr-color2::after,
.hr-color3::after,
.hr-color4::after {
    content: "";
    position: absolute;
    top: 0;
    left: -60px;
    width: 90px;
    height: 100%;
    pointer-events: none;
    animation: shine 15s infinite linear;
}

.hr-color1::after,
.hr-color2::after,
.hr-color3::after {
    background: linear-gradient(
        120deg,
        rgba(252, 232, 123, 0) 0%,
        rgba(250, 239, 178, 0.349) 50%,
        rgba(255, 215, 0, 0) 100%
    );
}

.hr-color::after,
.hr-color4::after {
    background: linear-gradient(
        120deg,
        rgba(252, 232, 123, 0) 0%,
        rgba(250, 239, 178, 0.185) 30%,
        rgba(255, 215, 0, 0) 100%
    );
}

@keyframes shine {
    0% {
        left: -60px;
    }
    100% {
        left: 100%;
    }
}
