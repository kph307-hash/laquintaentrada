@media (max-width: 1199px) {
    [data-tooltip]:before,
    [data-tooltip]:after,
    [data-tooltip-right]:after,
    [data-tooltip-left]:after,
    [data-tooltip-bottom]:after {
        opacity: 0 !important;
    }
}
/* data-tooltip (arriba) */
[data-tooltip] {
    position: relative;
    z-index: 1;
}
[data-tooltip]:before,
[data-tooltip]:after {
    visibility: hidden;
    -ms-filter: "progid:DXImageTransform.Microsoft.Alpha(Opacity=0)";
    filter: progid: DXImageTransform.Microsoft.Alpha(Opacity=0);
    opacity: 0;
    pointer-events: none;
}
.width-shipping [data-tooltip]:before,
.width-shipping [data-tooltip]:after {
    display: none;
}

[data-tooltip]:before {
    position: absolute;
    bottom: 93%;
    left: 50%;
    margin-bottom: 5px;
    margin-left: -80px;
    padding: 7px;
    width: 160px;
    -webkit-border-radius: 3px;
    -moz-border-radius: 3px;
    border-radius: 3px;
    background-color: #000;
    background-color: hsla(0, 0%, 20%, 0.9);
    color: #fff;
    content: attr(data-tooltip);
    text-align: center;
    font-size: 14px;
    line-height: 1.2;
    transition:
        opacity 500ms,
        transform 500ms;
}

[data-tooltip]:after {
    position: absolute;
    bottom: 93%;
    left: 50%;
    margin-left: -5px;
    width: 0;
    border-top: 5px solid #000;
    border-top: 5px solid hsla(0, 0%, 20%, 0.9);
    border-right: 5px solid transparent;
    border-left: 5px solid transparent;
    content: " ";
    font-size: 0;
    line-height: 0;
    transition:
        opacity 500ms,
        transform 500ms;
}
[data-tooltip]:hover:before,
[data-tooltip]:hover:after {
    visibility: visible;
    -ms-filter: "progid:DXImageTransform.Microsoft.Alpha(Opacity=100)";
    filter: progid: DXImageTransform.Microsoft.Alpha(Opacity=100);
    opacity: 1;
    transition-delay: 2s;
}

/* data-tooltip-top-big */
[data-tooltip-top-big]:after {
    opacity: 0;
    visibility: hidden;
    position: absolute;
    content: attr(data-tooltip-top-big);
    padding: 7px;
    max-width: fit-content;
    width: 415px;
    background-color: hsla(0, 0%, 20%, 0.9);
    color: #fff;
    z-index: 5;
    border-radius: 15px;
    transition:
        opacity 500ms,
        transform 500ms;
}
[data-tooltip-top-big]:hover:after {
    display: block;
    opacity: 1;
    visibility: visible;
    transition-delay: 1.5s;
}
[data-tooltip-top-big]:after {
    top: 0;
    left: 0;
    transform: translateX(0%) translateY(-110%);
}
[data-tooltip--top-big]:hover:after {
    transform: translateX(0%) translateY(0%);
}

/* data-tooltip-right */
[data-tooltip-right] {
    position: relative;
}
[data-tooltip-right]:after {
    opacity: 0;
    visibility: hidden;
    position: absolute;
    content: attr(data-tooltip-right);
    padding: 7px;
    width: 420px;
    background-color: hsla(0, 0%, 20%, 0.88);
    color: #fff;
    z-index: 5;
    border-radius: 15px;
    transition:
        opacity 500ms,
        transform 500ms;
}
[data-tooltip-right]:hover:after {
    display: block;
    opacity: 1;
    visibility: visible;
    transition-duration: 0.7s;
}
[data-tooltip-right]:after {
    top: 0px;
    left: 100%;
    transform: translateX(0%) translateY(0);
}
[data-tooltip-right]:hover:after {
    transform: translateX(4%) translateY(0);
}

/* data-tooltip-left */
[data-tooltip-left] {
    position: relative;
}
[data-tooltip-left]:after {
    opacity: 0;
    visibility: hidden;
    position: absolute;
    content: attr(data-tooltip-left);
    padding: 7px;
    width: 420px;
    background-color: hsla(0, 0%, 20%, 0.88);
    color: #fff;
    z-index: 5;
    border-radius: 15px;
    transition:
        opacity 500ms,
        transform 500ms;
}
[data-tooltip-left]:hover:after {
    display: block;
    opacity: 1;
    visibility: visible;
    transition-delay: 1.5s;
}
[data-tooltip-left]:after {
    top: 0px;
    left: 0;
    transform: translateX(-100%) translateY(0);
}
[data-tooltip-left]:hover:after {
    transform: translateX(-104%) translateY(0);
}

/* data-tooltip-bottom */
[data-tooltip-bottom]:after {
    opacity: 0;
    visibility: hidden;
    position: absolute;
    content: attr(data-tooltip-bottom);
    padding: 7px;
    max-width: fit-content;
    width: 415px;
    background-color: hsla(0, 0%, 20%, 0.9);
    color: #fff;
    z-index: 5;
    border-radius: 15px;
    transition:
        opacity 500ms,
        transform 500ms;
}
[data-tooltip-bottom]:hover:after {
    display: block;
    opacity: 1;
    visibility: visible;
    transition-delay: 1.5s;
}
[data-tooltip-bottom]:after {
    top: 135px;
    left: 0;
    transform: translateX(0%) translateY(0%);
}
[data-tooltip--bottom]:hover:after {
    transform: translateX(0%) translateY(90%);
}

/* tooltips right and left resposive con texto reducidos o estaticos (no db) */
[data-tooltip-r] {
    position: relative;
}
[data-tooltip-r]:after {
    opacity: 0;
    visibility: hidden;
    position: absolute;
    content: attr(data-tooltip-r);
    padding: 7px;
    width: fit-content;
    background-color: hsla(0, 0%, 20%, 0.88);
    color: #fff;
    z-index: 5;
    border-radius: 15px;
    transition: opacity 0.2s cubic-bezier(0.64, 0.09, 0.08, 1);
}
[data-tooltip-r]:hover:after {
    display: block;
    opacity: 1;
    visibility: visible;
}
[data-tooltip-r]:hover:before {
    opacity: 0;
}
[data-tooltip-r]:after {
    top: 0px;
    left: 100%;
    transform: translateX(12%) translateY(0);
}
[data-tooltip-r]:hover:after {
    transform: translateX(2%) translateY(0);
}
