    show_credits(type) {
      window.location.href = "/app/modules/finanzas/index.php?tt=cuentas-cobrar&st=" + type;
    },
    showBirthdayClients() {
      let ul = document.createElement("ul");

      this.clients_today.forEach((client) => {
        let li = document.createElement("li");
        li.innerHTML = `${client.code_client}/${client.name_client}`;
        li.classList.add("text-left");
        ul.appendChild(li);
      });
      swal({
        title: "Clientes con cumpleaños hoy",
        html: ul.outerHTML,
      });
    },
    today_events() {
      var events = this.events_today;
      //obtener los id de los calendarios
      var id_calendars = [];
      for (var i = 0; i < events.length; i++) {
        //evitar que se repitan los calendarios
        if (id_calendars.indexOf(events[i].id_calendar) == -1) {
          id_calendars.push(events[i].id_calendar);
        }
      }
      if (id_calendars.length > 1) {
        //mostrar un modal para seleccionar el calendario
        swal({
          title: "<strong>Tienes eventos de diferentes calendarios para el dia de hoy</strong>",
          type: "info",
          html:
            '<select id="calendar_select" class="selectpicker" data-style="btn btn-primary"  data-size="3" >' +
            '<option value="0">Seleccione un calendario</option>' +
            '<option v-for="calendar in calendars_today" :value="calendar.id_calendar">{{calendar.calendar_name}}></option>' +
            "</select>",
          showCloseButton: true,
          showCancelButton: true,
        }).then(function (result) {
          if (result) {
            var id_calendar = $("#calendar_select").val();
            if (id_calendar != 0) {
              window.location.href = "/app/modules/calendar/?id_event=" + id_calendar;
            }
          }
        });
        $(".selectpicker").selectpicker("refresh");
      } else {
        //enviar el id del evento al calendario
        window.location.href = "/app/modules/calendar/?id_event=" + id_calendars[0];
      }
    },
    pending_events() {
      var events = this.events_today;
      var events_warnings = this.events_warnings;
      var text = "";
      if (events_warnings.length > 0) {
        text = "y " + events_warnings.length + " con recordatorio ";
      }
      swal({
        title: '<strong  ">Tienes ' + events.length + " eventos para hoy " + text + "  </strong>",
        type: "info",
        showCancelButton: true,
        confirmButtonText: "Ver eventos",
        cancelButtonText: "Cancelar",
        confirmButtonClass: "btn btn-primary",
        cancelButtonClass: "btn btn-danger",
        buttonsStyling: false,
      }).then(function (result) {
        if (result) {
          if (events_warnings == 0 && events.length > 0) {
            window.location.href = "/app/modules/calendar/?show_event=false";
          } else if (events_warnings.length > 0) {
            window.location.href = "/app/modules/calendar/?show_event=true";
          } else if (events.length == 0 && events_warnings == 0) {
            window.location.href = "/app/modules/calendar/";
          }
        }
      });
      $(".selectpicker").selectpicker("refresh");
    },
    toggleDropdown(e) {
      if (e) {
        e.preventDefault();
        var el = $(e.currentTarget);
      }
      $("body").prepend('<div id="dropdownOverlay" style="background: transparent; height:100%;width:100%;position:fixed;"></div>');
      var container = $(e.currentTarget).parent();
      var dropdown = container.find(".dropdown");
      var containerWidth = container.width();
      dropdown.css({
        right: containerWidth / 2 + "px",
      });
      container.toggleClass("expanded");

      // Guardar timestamp cuando el usuario interactúa con las notificaciones
      const currentTime = moment().format("YYYY-MM-DD H:mm:ss");
      localStorage.setItem(this.idCompany + "_notifications_dismissed", currentTime);
    },
