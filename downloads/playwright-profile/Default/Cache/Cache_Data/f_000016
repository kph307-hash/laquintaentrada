import vGraphic from "/app/modules/productos/js/graphics.js?v=1.0.14"; //el componente para los graficos
import vSearch from "/app/js/searchCompany.js?v=1.10"; //el component para le buscador de empresas cuando se va a iniciar sesion
import vOptions from "/app/js/optionsMenu.js?v=1.3"; //el component para  las opciones del menu

var vIndex = new Vue({
  el: "#vIndex",
  name: "vIndex",
  components: {
    app2: vGraphic,
    search: vSearch,
    opciones: vOptions,
  },
  data: {
    totalCompanyStatistics: 0,
    is_admin: is_admin,
    idCompany: idCompany,
    company_plan: "", // Nombre del plan calculado
    subscription: null, // Datos de la suscripción desde modalPayment.php
    CostoPlanIva: 0, // Costo del plan con IVA
    //Info de la empresa registrado por el bot
    total_notifications: 0,
    total_old_notifications: 0,
    total_carrito: 0,
    total_products: 0,
    total_contracts: 0,
    total_contracts_hoy: 0,
    total_bulk_bills: 0,
    no_cashier_bills: 0,
    no_send_bills: 0,
    peticiones_contrasena: 0,
    peticiones_caja: 0,
    total_pending_movements: 0,
    total_notices: 0,
    calendars_today: [],
    events: [],
    events_warnings: [],
    events_today: [],
    //************ variables globales ************ //
    show_new_notice: show_new_notice,
    accepted_terms: accepted_terms,
    use_private_s: 0,
