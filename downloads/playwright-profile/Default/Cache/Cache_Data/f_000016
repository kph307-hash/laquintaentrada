    async loadPendingDocs() {
      const db = app.getDb("dbApp");
      const accountId = uuidCompany.substr(0, 16) + uuidUser.substr(16);
      let entries = await db.queue.where("accountId").equals(accountId).count();

      if (entries > 0) {
        this.pending_docs = entries;
        document.querySelector("#pending-documents").style.display = "block";
        document.querySelector("#qty-pending-docs").innerText = entries;
      }
    },
    pendingDocsMsg() {
      swal({
        title: "¡Hay documentos pendientes!",
