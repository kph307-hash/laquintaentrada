    cualModalPago: "",
    /** Permisos */
    permisos: permisos,
    logo_url: "",
    clients_today: [],
    version_logs: [],
    count_new_version: 0,

    /** Novedades */
    novedades: [],
    consiguiendo: false,
    estadoNovedades: 0, // 0 cerrado, 1 abierto, 2 cerrando
    novedadesTodasCargadas: false,

    /** Notificaciones persistentes (carrito, etc.) */
    unread_notifications: 0,
    persistent_notifications: [],
    notificationsPusher: null,
  },
  methods: {
    getVersions() {
      this.estadoNovedades = 1;
      if (this.novedades.length === 0) {
        this.cargarNovedades();
      }
    },
    closeVersions() {
      this.estadoNovedades = 2;
      setTimeout(() => {
        this.estadoNovedades = 0;
      }, 200);
    },
    cargarNovedades() {
      if (this.consiguiendo) return;
      this.consiguiendo = true;
      const start = this.novedades.length;
      fetch(`/app/ajax/consultasIndex.php?action=getVersions&start=${start}&limit=10`)
        .then((response) => {
          if (response.ok) {
            return response.json();
          } else {
            throw new Error("Error al obtener la lista de novedades");
          }
        })
        .then((data) => {
          const results = data.map((item) => ({ modulesList: item.modules.split(","), ...item }));
          this.consiguiendo = false;
          this.novedades = this.novedades.concat(results);
          this.novedadesTodasCargadas = results.length < 10;
        })
        .catch((error) => {
          this.consiguiendo = false;
          app.showNotification("danger", error.message);
        });
    },
    getTextsCarrito() {
      if (!this.useShoppingCart) {
        if (is_admin != "1") {
          return {
            title: "La empresa no tiene tienda en línea creada.",
            text: "Por favor, ponte en contacto con un administrador.",
            textButtonConfirm: "Gracias",
            textButtonCancel: "",
          };
        }
        return {
          title: "No tienes tienda en línea creada.",
          text: "",
          textButtonConfirm: "Crear tienda",
          textButtonCancel: "Cancelar",
        };
      }

      return {
        title: "Elige una opción:",
        text: "",
        textButtonConfirm: "Ir a tienda en línea",
        textButtonCancel: "Copiar enlace de tienda",
      };
    },
    mensajeTienda() {
      const { title, text, textButtonConfirm, textButtonCancel } = this.getTextsCarrito();
      const url = this.useShoppingCart ? this.url_shopping_cart : "modules/configuracion/update.php/#tienda-online";
      const showCancelButton = textButtonCancel !== "";

      swal({
        title: title,
        text: text,
        showCancelButton: showCancelButton,
        type: "question",
        width: 500,
        confirmButtonText: textButtonConfirm,
        cancelButtonText: textButtonCancel,
        confirmButtonClass: "swal-btn-carrito",
        cancelButtonClass: "swal-btn-carrito swal-btn-margin",
      }).then(
        function (result) {
          if (is_admin != "1" && !vIndex.useShoppingCart) {
            return; // Evitar redirección si no es admin y no se usa carrito
          }
          window.location.href = url;
        },
        function (dismiss) {
          if (dismiss == "cancel" && textButtonCancel != "Cancelar") {
            copyToClipboard(url);
            swal("Vínculo copiado", "Enlace del carrito copiado correctamente", "success");
          }
        },
      );
    },
    // Nueva función para obtener datos de la suscripción
    getSubscriptionData() {
      return $.post(serverURL + "/app/ajax/modalPayment.php", {
        action: "getSubscription",
        json: 1,
        id_company_selected: this.idCompany,
      })
        .then((d) => {
          this.subscription = d.subscription;
          const amount = this.subscription.roundedAmount;
          this.CostoPlanIva = `₡${Number(amount).toLocaleString("es-CR")}`;
          // Calcular company_plan como en modalPayment.php
          if (this.subscription) {
            const countPlans = this.subscription.plan_count || 1; // Si no hay conteo explícito, asumir 1
            this.company_plan = countPlans === 1 ? this.subscription.plan : `(Suscripción con ${countPlans} planes)`;
          } else {
            this.company_plan = "Desconocido";
          }
        })
        .catch((e) => {
          console.error("Error al obtener datos de la suscripción:", e);
          this.company_plan = "Desconocido";
        });
    },
    //obtener la informacion de que si exsiten datos para los graficos
    getStatics() {
      $.post(serverURL + "/app/ajax/consultasIndex.php", {
        action: "getStatistics",
      })
        .then((d) => {
          this.totalCompanyStatistics = d.total_statistics;
          this.allow_payment = d.allow_payment == true ? 0 : 1;
          window.graphScopeOptions = d.graph_scope_options || [];
          window.graphScopeDefault = d.graph_scope_default || `company:${this.idCompany}`;
          let index_info = d.last_info_index;
          this.count_new_version = d.count_new_version;
          if (index_info != 0) {
            for (const key in index_info) {
              //vemos si existe esa varibale en vue
              if (this.hasOwnProperty(key)) {
                //guardar variable en vue, son las del apartado del info dado por el bot
                this[key] = index_info[key];
              }
            }
          }
          if (this.idCompany > 0) {
            //verificacion para mostrar la noticia al iniciar sesion, el usuario debe no haber visto la noticia y haber aceptado los terminos y condiciones
            if (this.show_new_notice == 1 && this.accepted_terms == 1 && this.total_notices > 0) {
              this.modalNotice();
            }
            //ver si el link contiene facture.cr
            if (this.use_private_s == 1 && window.location.href.indexOf("facture.cr") > -1) {
              this.modalTermsConditions(1);
            } else if (this.accepted_terms == 0 && this.use_private_s == 0) {
              this.modalTermsConditions();
            }

            let is_support = Number(SYSAD);
            //si los total_old_notifications es diferente a las notificaciones actuales, tiramos notificacion
            if (this.total_old_notifications < this.total_notifications) {
              // Verificar si ha pasado al menos 1 día desde la última vez que el usuario hizo clic en la campana
              let shouldShowNotification = true;
              const lastDismissed = localStorage.getItem(this.idCompany + "_notifications_dismissed");

              if (lastDismissed) {
                const timeSinceDismissed = moment().diff(moment(lastDismissed, "YYYY-MM-DD H:mm:ss"), "minutes");
                if (timeSinceDismissed < 1440) {
                  // Menos de 1 día (1440 minutos)
                  shouldShowNotification = false;
                }
              }

              if (APP_NAME == "Facture" && shouldShowNotification && !is_support) {
                //son diferentes, tiramos notificacion
                let diff = this.total_notifications - this.total_old_notifications;
                let text = diff == 1 ? "tienes 1 nueva notificación" : `tienes ${diff} nuevas notificaciones`;
                $.notify(
                  {
                    title: "¡Nuevas notificaciones!",
                    icon: "notifications", // Cambiado de "update" a "notifications" para que sea más apropiado
                    message: `<strong>¡Hola!</strong> ${text}, haz clic en el ícono de la campana (🔔) para verlas.`,
                  },
                  {
                    type: "warning",
                    delay: 50000,
                    z_index: 10000,
                    placement: {
                      from: "bottom",
                      align: "left",
                    },
                  },
                );
                // Actualizar total_old_notifications cuando se muestran las notificaciones
                this.total_old_notifications = this.total_notifications;
                const audio = new Audio(rootURL + "/app/assets/sounds/notificationSoud.wav"); //cargamos el audio
                audio.play();
              }
            }
          }
        })
        .catch((e) => console.error(e));
    },
    /** Inicializar suscripción para actualizar contadores del dashboard (reutiliza canal global) */
    initNotificationsPusher() {
      try {
        var channel = window._globalCartNotifChannel;
        if (!channel) {
          // Fallback: crear conexión propia si no existe la global
          this.notificationsPusher = new Pusher(pusherApiKey, {
            cluster: pusherCluster,
            channelAuthorization: {
              endpoint: rootURL + 'app/user/auth.php',
            },
          });
          channel = this.notificationsPusher.subscribe(`private-${this.idCompany}-notifications`);
        }

        channel.bind('new-notification', (data) => {
          // Actualizar contadores del dashboard
          this.unread_notifications++;
          this.total_notifications++;
          this.persistent_notifications.unshift(data);
        });
      } catch (e) {
        console.error('Error al inicializar Pusher de notificaciones:', e);
      }
    },
    /** Obtener notificaciones persistentes no leídas */
    fetchNotifications() {
      $.get(serverURL + '/app/ajax/consultasIndex.php', {
        action: 'getNotifications',
        type: 'unread',
        limit: 20,
      })
        .then((d) => {
          this.persistent_notifications = d.notifications || [];
          this.unread_notifications = d.unread_count || 0;
        })
        .catch((e) => console.error('Error al obtener notificaciones:', e));
    },
    /** Marcar una notificación como leída */
    markNotificationRead(id_notification) {
      $.post(serverURL + '/app/ajax/consultasIndex.php', {
        action: 'markNotificationRead',
        id_notification: id_notification,
      })
        .then(() => {
          // Eliminar de la lista local
          this.persistent_notifications = this.persistent_notifications.filter(
            (n) => n.id_notification != id_notification,
          );
          if (this.unread_notifications > 0) {
            this.unread_notifications--;
          }
        })
        .catch((e) => console.error('Error al marcar notificación:', e));
    },
    /** Marcar todas las notificaciones como leídas */
    markAllNotificationsRead() {
      $.post(serverURL + '/app/ajax/consultasIndex.php', {
        action: 'markAllNotificationsRead',
      })
        .then(() => {
          this.persistent_notifications = [];
          this.unread_notifications = 0;
        })
        .catch((e) => console.error('Error al marcar notificaciones:', e));
    },
    getVariables() {
      $.post(serverURL + "/app/ajax/consultasIndex.php", {
        action: "getVaribales",
      })
        .then((d) => {
          let index_info = d.variables;
          if (index_info != 0) {
            for (const key in index_info) {
              //vemos si existe esa varibale en vue
              if (this.hasOwnProperty(key)) {
                //guardar variable en vue, son las del apartado del info dado por el bot
                this[key] = index_info[key];
              }
            }
          }
          if (this.status_company == "MO" && this.is_admin == "1") {
            // Obtener datos de la suscripción antes de verificar
            this.getSubscriptionData().then(() => {
              this.verifySub();
            });
          }
        })
        .catch((e) => console.error(e));
    },
    openModal(idCompany) {
      // Llamar a la función correspondiente según el valor de cualModalPago
      if (this.cualModalPago === "modalPago") {
        modalPago(idCompany);
      } else if (this.cualModalPago === "modalPagoWorkgroup") {
        modalPagoWorkgroup(idCompany);
      }
    },
    goTo(action) {
      switch (action) {
        case "productos":
          window.location.replace("modules/productos/index.php?tt=adm-pro&limit_exist=1");
          break;
        case "proformas":
          window.location.replace("modules/punto_de_venta/index.php?action=showProforma");
          break;
        case "contractos":
          window.location.replace("modules/contratos/contratos.php?morosos=1");
          break;
        case "report_trans":
          window.location.replace("modules/productos/index.php?tt=adm-bodegas&type=2");
          break;
        case "no_cashier_bills":
          window.location.replace("modules/ventas/index.php?tt=adm&type=0&no_cashier_bills=1");
          break;
        case "no_send_bills":
          window.location.replace("modules/ventas/index.php?tt=adm&type=0&no_send_bills=1");
          break;
        default:
          break;
      }
    },
