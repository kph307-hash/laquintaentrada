              text: "Esperamos que se encuentre muy bien. Nos gustaría informarle que hemos tenido inconvenientes para verificar el comprobante de pago de su suscripción. Le solicitamos amablemente que se ponga en contacto con nuestro equipo de soporte para solucionar este inconveniente. Alternativamente, puede enviarnos nuevamente el comprobante, asegurándose de que sea visible el número de comprobante o el número de referencia de la transferencia para poder corroborarlo.\nLamentamos cualquier inconveniente que esto pueda causar y le pedimos disculpas por el contratiempo. Agradecemos su comprensión y colaboración.",
              type: "warning",
              showCancelButton: true,
              cancelButtonClass: "btn",
              cancelButtonText: "Lo haré despues",
              confirmButtonClass: "btn btn-success",
              confirmButtonText: "Contactar a soporte",
              buttonsStyling: false,
            })
              .then((result) => {
                if (result) {
                  modalSupport(self.idCompany);
                }
              })
              .catch(swal.noop);
          } else if (this.show_message_morosidad != 3) {
            //si es de una suscripcion privada y tiene suscripcion de grupo de trabajo
            if (this.allow_payment == 0) {
              mostrar_modal_pago =
                '<strong><a href=\"#\" class="btn btn-primary text-info" style="font-size: 20px; padding: 20px 40px;" onclick="modalPagoWorkgroup(idCompany)">REGISTRA TU<br>PAGO AQUÍ</a></strong>';
            }
            swal({
              title: "¡Su suscripción ha caducado!",
              text:
                `La empresa asociada a este sistema cuenta con el plan <strong>${this.company_plan}</strong>, el cual está ligado a una suscripción que actualmente se encuentra vencida.<br><br>` +
                `Para evitar interrupciones en su operación, le ofrecemos un período de gracia. Aún dispone de <strong>${this.num_days} día${this.num_days > 1 ? "s" : ""}</strong> para realizar el pago correspondiente.<br>` +
                `Si no se efectúa dentro de este plazo, lamentablemente los servicios serán suspendidos.<br><br>` +
                `Agradecemos profundamente su comprensión y confianza. Estamos para servirle.` +
                mostrar_modal_pago,
              type: "warning",
              showCancelButton: true,
              cancelButtonClass: "btn",
              cancelButtonText: "Lo haré despues",
              confirmButtonClass: "btn btn-success",
              confirmButtonText: "Contactar a soporte",
              buttonsStyling: false,
            })
              .then((result) => {
                if (result) {
                  self.modalPagoWorkgroup(self.idCompany);
                }
              })
              .catch(swal.noop);
            localStorage.setItem(self.idCompany + "_payment_alert", thisAlert);
          }
        }
      }
    },
    async restoreDatos() {
      if (localStorage.getItem("uidRestore") && localStorage.getItem("uidRestore") == uuidCompany) {
        //restaurar datos
        try {
          let filePath = uuidCompany + "_backup" + ".json";
          await app.init_navedi();
          let datos = await navedi.file.read(filePath);
          datos = JSON.parse(datos);
          await app.enableDbApp();
          await app.getDb("dbApp").queue.bulkPut(datos);

          //salio bien, eliminamos el backup
          localStorage.removeItem("uidRestore");
          await navedi.file.remove(filePath);
        } catch (e) {
          console.error("Error al restaurar datos: " + e.message);
        }
      }
    },
  },
  mounted() {
    let self = this;
    this.getVariables();
    if (this.idCompany > 0) {
      this.getStatics();
      this.fetchNotifications();
      app.enableDbApp().then(() => {
        self.loadPendingDocs();
      });
      // cada 5 min recargar las estadisticas
      setInterval(() => {
        self.getStatics();
      }, 300000); // 300,000 ms = 5 minutos
    }

    window.onclick = function (e) {
      var el = $(e.currentTarget)[0].activeElement;
      if (!e.target.matches("#btnNoti") && typeof $(el).attr("data-dropdown") === "undefined") {
        $("#dropdownOverlay").remove();
        $(".dropdown-container.expanded").removeClass("expanded");
      }
    };
    //Dropdown collapsile tabs
    $(".notification-tab").click(function (e) {
      if ($(e.currentTarget).parent().hasClass("expanded")) {
        $(".notification-group").removeClass("expanded");
      } else {
        $(".notification-group").removeClass("expanded");
        $(e.currentTarget).parent().toggleClass("expanded");
      }
    });

    this.restoreDatos();

    // Suscribirse al canal de notificaciones en tiempo real vía Pusher
    if (this.idCompany > 0 && typeof pusherApiKey !== 'undefined' && pusherApiKey) {
      this.initNotificationsPusher();
    }
  },
  beforeDestroy() {
    // Limpiar la conexión de Pusher al destruir el componente
    if (this.notificationsPusher) {
      this.notificationsPusher.disconnect();
      this.notificationsPusher = null;
    }
  },
});

window.loadIndexVariables = vIndex.getVariables;
window.loadIndexStatics = vIndex.getStatics;
window.showVersionLogs = vIndex.getVersions;
window.showNotifications = vIndex.toggleDropdown;
window.openModal = vIndex.openModal;
