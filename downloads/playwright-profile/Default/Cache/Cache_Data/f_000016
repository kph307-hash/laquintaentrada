                <div style="padding: 15px">
                Hay <strong>${this.pending_docs}</strong> documentos pendientes, ve al <strong>punto de venta</strong> para reenviarlos
                </div?`,
        showCancelButton: true,
        cancelButtonText: "No, gracias",
        confirmButtonText: "Ir a Punto de Venta",
        reverseButtons: true,
      }).then(() => {
        goToPage("puntoDeVenta", "assign", {
          action: "pendingDocs",
        });
      });
    },
    modalChangePassword() {
      $("body").append(`<div id="modal_password" ></div>`);
      $("#modal_password").load(rootURL + "app/modules/configuracion/modal_password.php", function () {
        $("#modalPass").modal("show");
      });
    },
    modalVerifyCashiers() {
      $("body").append(`<div id="modalVerifyCashiersContainer" ></div>`);
      if (typeof vVerificacionesCierre === "undefined") {
        $("#modalVerifyCashiersContainer").load(rootURL + "app/modules/configuracion/modal_verificaciones_cierre.php", function () {
          vVerificacionesCierre.open();
        });
      } else {
        vVerificacionesCierre.open();
      }
